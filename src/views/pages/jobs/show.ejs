<% const left = daysLeft(job.deadline);
   const isLink = job.applyMode === 'link';
   const applyHost = isLink ? (() => { try { return new URL(job.applyUrl).hostname.replace(/^www\./, ''); } catch { return 'lien externe'; } })() : '';
   const applyEvent = `$dispatch('open-apply', { slug: '${job.slug}', mode: '${job.applyMode}', title: ${JSON.stringify(job.title)}, company: ${JSON.stringify(job.companyName)}${pendingApplicationId ? `, pendingId: ${pendingApplicationId}` : ''} })`; %>
<div x-data <%- autoApply && !isLink && !job.isExpired && !canManage ? `x-init="$nextTick(() => ${escapeHtml(applyEvent)})"` : '' %> class="space-y-2 pb-4 sm:space-y-4">
  <article class="card" aria-labelledby="job-title">
    <% if (job.image) { %>
      <img src="<%= imageUrl(job.image, 1200) %>" alt="<%= job.title %> — <%= job.companyName %>" decoding="async" class="block max-h-[520px] w-full bg-gray-100 object-cover sm:rounded-t-lg">
    <% } %>
    <div class="px-4 pt-4 sm:px-6 sm:pt-6">
      <a href="/offres" class="mb-3 inline-flex items-center gap-1 text-sm font-medium text-gray-500 hover:underline"><%- icon('arrowLeft', 'w-4 h-4') %> Toutes les offres</a>
      <div class="flex gap-3">
        <%- include('../../partials/companyLogo', { job, size: 'w-16 h-16' }) %>
        <div class="min-w-0">
          <div class="flex flex-wrap gap-1.5"><%- include('../../partials/jobBadges', { post, job }) %></div>
          <h1 id="job-title" class="mt-1 text-2xl font-bold leading-tight"><%= job.title %></h1>
          <p class="mt-0.5 font-medium text-gray-700"><%= job.companyName %></p>
        </div>
      </div>
      <%- include('../../partials/adSlot', { slot: 'jobTop', inline: true }) %>

      <dl class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
        <div class="rounded-lg bg-gray-50 p-2.5"><dt class="text-xs text-gray-500">Lieu</dt><dd class="font-semibold"><%= job.location %></dd></div>
        <div class="rounded-lg bg-gray-50 p-2.5"><dt class="text-xs text-gray-500">Contrat</dt><dd class="font-semibold"><%= job.contractType %></dd></div>
        <div class="rounded-lg bg-gray-50 p-2.5"><dt class="text-xs text-gray-500">Secteur</dt><dd class="font-semibold"><%= job.sector %></dd></div>
        <div class="rounded-lg bg-gray-50 p-2.5"><dt class="text-xs text-gray-500">Date limite</dt>
          <dd class="font-semibold <%= left !== null && left >= 0 && left <= 3 ? 'text-red-600' : '' %>"><%= job.deadline ? formatDate(job.deadline) : 'Non précisée' %></dd></div>
        <% if (job.salary) { %><div class="col-span-2 rounded-lg bg-gray-50 p-2.5 sm:col-span-4"><dt class="text-xs text-gray-500">Salaire</dt><dd class="font-semibold"><%= job.salary %></dd></div><% } %>
      </dl>
      <p class="mt-3 text-xs text-gray-500">Publiée <%= timeAgo(post.createdAt) === "À l'instant" ? "à l'instant" : `il y a ${timeAgo(post.createdAt)}` %> par
        <a href="/profil/<%= post.author.username %>" class="font-medium hover:underline"><%= post.author.firstName %> <%= post.author.lastName %></a> · <%= formatCount(post.viewsCount) %> vue<%= post.viewsCount > 1 ? 's' : '' %></p>

      <% if (canManage) { %>
        <div class="mt-4 flex flex-wrap items-center gap-2 rounded-lg bg-brand-50 p-3 text-sm">
          <span class="flex-1 text-brand-800">
            <% if (post.featureStatus === 'pending') { %>Demande de mise à la une : <strong>en attente de validation</strong>.
            <% } else if (post.featureStatus === 'rejected') { %>Mise à la une refusée<%= post.featureRejectReason ? ` : ${post.featureRejectReason}` : '' %>.
            <% } else if (post.isFeatured) { %>À la une jusqu'au <strong><%= formatDate(post.featuredUntil) %></strong>.
            <% } else { %>Vous gérez cette offre.<% } %>
          </span>
          <a href="<%= job.url %>/modifier" class="btn-light !py-1.5 text-sm"><%- icon('pencil', 'w-4 h-4') %> Modifier</a>
          <form action="<%= job.url %>/supprimer" method="post" x-data @submit="confirm('Supprimer définitivement cette offre ?') || $event.preventDefault()">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn !py-1.5 text-sm bg-white text-red-600 hover:bg-red-50"><%- icon('trash', 'w-4 h-4') %> Supprimer</button>
          </form>
        </div>
      <% } %>
    </div>

    <div class="space-y-5 px-4 py-5 sm:px-6">
      <% if (post.text) { %><p class="whitespace-pre-line rounded-lg border-l-4 border-brand-200 pl-3 text-[15px] text-gray-700"><%- richText(post.text) %></p><% } %>
      <section><h2 class="mb-2 text-lg font-semibold">Description du poste</h2><div class="whitespace-pre-line text-[15px] leading-relaxed text-gray-800"><%- richText(job.description) %></div></section>
      <% if (job.requirements) { %><section><h2 class="mb-2 text-lg font-semibold">Profil recherché</h2><div class="whitespace-pre-line text-[15px] leading-relaxed text-gray-800"><%- richText(job.requirements) %></div></section><% } %>
      <% if (job.benefits) { %><section><h2 class="mb-2 text-lg font-semibold">Avantages</h2><div class="whitespace-pre-line text-[15px] leading-relaxed text-gray-800"><%- richText(job.benefits) %></div></section><% } %>

      <section id="postuler" class="scroll-mt-32 rounded-lg border border-gray-200 p-4" <%- pendingApplicationId && !isLink && !job.isExpired && !canManage ? `x-data x-init="$nextTick(() => ${escapeHtml(applyEvent)})"` : '' %>>
        <h2 class="text-lg font-semibold">Postuler</h2>
        <% if (job.isExpired) { %>
          <p class="mt-1 text-sm text-gray-600">Cette offre est clôturée depuis le <%= formatDate(job.deadline) %>.</p>
        <% } else { %>
          <% if (canManage) { %>
            <% if (job.applyMode === 'link') { %>
              <p class="mt-1 text-sm text-gray-600">Le bouton « Postuler » envoie les candidats vers <a href="<%= job.applyUrl %>" target="_blank" rel="noopener nofollow ugc" class="break-all font-semibold text-brand-600 hover:underline"><%= job.applyUrl %></a>.</p>
            <% } else if (job.applyMode === 'platform') { %>
              <p class="mt-1 text-sm text-gray-600">Les candidatures arrivent dans votre <a href="/mes-offres/<%= job.slug %>/candidatures" class="font-semibold text-brand-600 hover:underline">tableau de recrutement</a>.</p>
            <% } else { %>
              <p class="mt-1 text-sm text-gray-600">Les candidatures arrivent à <strong><%= job.applyEmail %></strong> et dans <a href="/mes-offres/<%= job.slug %>/candidatures" class="font-semibold text-brand-600 hover:underline">la liste des candidatures</a>.</p>
            <% } %>
          <% } else if (job.applyMode === 'link') { %>
            <p class="mt-1 text-sm text-gray-600">La candidature se fait sur le site du recruteur (<%= applyHost %>).</p>
            <a href="<%= job.applyUrl %>" target="_blank" rel="noopener nofollow ugc" class="btn-primary mt-3 w-full !py-3 text-base"><%- icon('link', 'w-4 h-4') %> Postuler sur le site du recruteur</a>
          <% } else { %>
            <p class="mt-1 text-sm text-gray-600"><%= job.applyMode === 'platform' ? 'Postulez directement sur SenTravail et suivez votre candidature étape par étape.' : "Envoyez votre CV et un message au recruteur en moins d'une minute." %></p>
            <button type="button" class="btn-primary mt-3 w-full !py-3 text-base" @click="<%= applyEvent %>">Postuler</button>
          <% } %>
        <% } %>
        <%- include('../../partials/scamWarning') %>
      </section>
    </div>

    <%- include('../../partials/postSocial', { post, oob: false }) %>
  </article>
  <%- include('../../partials/adSlot', { slot: 'jobBottom' }) %>

  <% if (similarPosts.length) { %>
    <section aria-labelledby="similar-title" class="px-2 sm:px-0">
      <h2 id="similar-title" class="mb-2 px-1 text-lg font-semibold">Offres similaires</h2>
      <div class="grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-3">
        <% similarPosts.forEach(sp => { %><%- include('../../partials/jobTile', { post: sp }) %><% }) %>
      </div>
      <p class="mt-3 text-center"><a href="/offres<%= queryString({ secteur: job.sector }) %>" class="text-sm font-semibold text-brand-600 hover:underline">Voir toutes les offres <%= job.sector %></a></p>
    </section>
  <% } %>
</div>
