<% const v = values; const err = errors; const action = mode === 'edit' ? `${job.url}/modifier` : '/offres/nouvelle'; %>
<div class="card rounded-lg px-4 py-5 sm:px-6">
  <div class="mb-4 flex items-center gap-2">
    <a href="<%= mode === 'edit' ? job.url : '/' %>" class="icon-btn !bg-transparent" aria-label="Retour"><%- icon('arrowLeft', 'w-5 h-5') %></a>
    <h1 class="text-xl font-semibold"><%= mode === 'edit' ? "Modifier l'offre" : "Publier une offre d'emploi" %></h1>
  </div>
  <% if (Object.keys(err).length) { %><p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">Corrigez les champs indiqués en rouge.</p><% } %>

  <form method="post" action="<%= action %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="space-y-4" novalidate>
    <%- include('../../partials/field', { name: 'title', label: 'Intitulé du poste *', placeholder: 'Ex. Comptable confirmé(e)', required: true }) %>
    <%- include('../../partials/field', { name: 'companyName', label: 'Entreprise *', autocomplete: 'organization', required: true }) %>
    <div x-data="{ preview: <%= mode === 'edit' && job.image ? `'${imageUrl(job.image, 800)}'` : 'null' %> }">
      <label for="f-image" class="label">Image de l'offre (facultatif)</label>
      <p class="mb-1.5 text-xs text-gray-500">Affiche ou visuel : affichée en grand dans le fil et lors des partages sur Facebook ou WhatsApp. Format paysage conseillé (1200 × 630). 2 Mo max.</p>
      <template x-if="preview"><img :src="preview" alt="" class="mb-2 max-h-56 w-full rounded-lg bg-gray-100 object-cover"></template>
      <input id="f-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" data-compress
        @change="preview = $event.target.files[0] ? URL.createObjectURL($event.target.files[0]) : preview"
        class="block w-full text-sm text-gray-600 file:mr-3 file:rounded-md file:border-0 file:bg-gray-200 file:px-3 file:py-2.5 file:font-semibold">
      <% if (mode === 'edit' && job.image) { %>
        <label class="mt-2 inline-flex items-center gap-2 text-sm text-gray-600"><input type="checkbox" name="removeImage" class="rounded border-gray-300"> Retirer l'image</label>
      <% } %>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <% [['location', 'Ville *', CITIES], ['contractType', 'Contrat *', CONTRACT_TYPES], ['sector', 'Secteur *', SECTORS]].forEach(([name, label, options]) => { %>
        <div>
          <label for="f-<%= name %>" class="label"><%= label %></label>
          <select id="f-<%= name %>" name="<%= name %>" class="input <%= err[name] ? 'input-error' : '' %>" required>
            <option value="">— Choisir —</option>
            <% options.forEach(o => { %><option <%= v[name] === o ? 'selected' : '' %>><%= o %></option><% }) %>
          </select>
          <% if (err[name]) { %><p class="field-error"><%= err[name] %></p><% } %>
        </div>
      <% }) %>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <%- include('../../partials/field', { name: 'salary', label: 'Salaire (facultatif)', placeholder: 'Ex. 350 000 – 450 000 FCFA / mois' }) %>
      <%- include('../../partials/field', { name: 'deadline', type: 'date', label: 'Date limite de candidature' }) %>
    </div>
    <div>
      <label for="f-description" class="label">Description du poste *</label>
      <textarea id="f-description" name="description" rows="12" maxlength="8000" class="input <%= err.description ? 'input-error' : '' %>" placeholder="Missions, profil recherché (diplômes, expérience, compétences), avantages, horaires…"><%= v.description || '' %></textarea>
      <% if (err.description) { %><p class="field-error"><%= err.description %></p><% } %>
    </div>

    <% const canLink = currentUser.isVerified || currentUser.role === 'admin'; %>
    <fieldset x-data="{ mode: '<%= v.applyMode === 'link' ? 'link' : 'email' %>' }">
      <legend class="label">Comment recevoir les candidatures ? *</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3" :class="mode === 'email' ? 'border-brand-600 bg-brand-50' : 'border-gray-200'">
          <input type="radio" name="applyMode" value="email" x-model="mode" class="mt-1 h-4 w-4">
          <span><span class="font-semibold">Par email</span><span class="block text-sm text-gray-500">Les candidats postulent sur SenTravail ; vous recevez leur message et leur CV par email.</span></span>
        </label>
        <label class="flex items-start gap-3 rounded-lg border p-3 <%= canLink ? 'cursor-pointer' : 'opacity-60' %>" :class="mode === 'link' ? 'border-brand-600 bg-brand-50' : 'border-gray-200'">
          <input type="radio" name="applyMode" value="link" x-model="mode" class="mt-1 h-4 w-4" <%= canLink ? '' : 'disabled' %>>
          <span><span class="font-semibold">Par lien externe</span><span class="block text-sm text-gray-500"><%= canLink ? 'Le bouton « Postuler » ouvre votre site ou votre formulaire de candidature.' : 'Réservé aux comptes vérifiés (badge vérifié).' %></span></span>
        </label>
      </div>
      <div x-show="mode === 'email'" class="mt-3">
        <label for="f-applyEmail" class="label">Email de réception des candidatures *</label>
        <input id="f-applyEmail" name="applyEmail" type="email" autocomplete="off" value="<%= v.applyEmail || '' %>" placeholder="Ex. recrutement@entreprise.sn" class="input <%= err.applyEmail ? 'input-error' : '' %>">
        <% if (err.applyEmail) { %><p class="field-error"><%= err.applyEmail %></p><% } %>
      </div>
      <div x-show="mode === 'link'" x-cloak class="mt-3">
        <label for="f-applyUrl" class="label">Lien de candidature *</label>
        <input id="f-applyUrl" name="applyUrl" type="url" inputmode="url" value="<%= v.applyUrl || '' %>" placeholder="https://www.entreprise.sn/carrieres/poste" class="input <%= err.applyUrl ? 'input-error' : '' %>">
        <% if (err.applyUrl) { %><p class="field-error"><%= err.applyUrl %></p><% } %>
      </div>
    </fieldset>
    <div>
      <label for="f-text" class="label">Message d'accompagnement dans le fil (facultatif)</label>
      <textarea id="f-text" name="text" rows="2" maxlength="2000" class="input" placeholder="Ex. Nous recrutons ! Partagez autour de vous 🙏"><%= v.text || '' %></textarea>
    </div>

    <% if (mode === 'create') { %>
      <% if (currentUser.role === 'admin') { %>
        <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3">
          <input type="checkbox" name="isOfficial" class="mt-1 h-4 w-4" <%= v.isOfficial ? 'checked' : '' %>>
          <span><span class="font-semibold">Offre officielle</span><span class="block text-sm text-gray-500">Badge « Officielle » et mise à la une immédiate pour tous les utilisateurs.</span></span>
        </label>
      <% } else { %>
        <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3">
          <input type="checkbox" name="requestFeatured" class="mt-1 h-4 w-4" <%= v.requestFeatured ? 'checked' : '' %>>
          <span><span class="font-semibold">Demander la mise à la une</span><span class="block text-sm text-gray-500">Après validation par SenTravail, votre offre sera épinglée en haut du fil de tous les utilisateurs. En attendant, elle est visible par vous et vos abonnés.</span></span>
        </label>
      <% } %>
    <% } %>

    <div class="flex justify-end gap-2 pt-2">
      <a href="<%= mode === 'edit' ? job.url : '/' %>" class="btn-light">Annuler</a>
      <button type="submit" class="btn-primary"><%= mode === 'edit' ? 'Enregistrer' : "Publier l'offre" %></button>
    </div>
  </form>
</div>
