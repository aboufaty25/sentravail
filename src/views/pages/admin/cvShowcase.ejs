<%- include('../../partials/adminNav') %>
<%- include('../../partials/admin/cvTabs') %>

<section class="card mb-3 rounded-lg p-4" aria-labelledby="sc-title">
  <h2 id="sc-title" class="text-lg font-semibold">Vitrine des CV</h2>
  <p class="text-sm text-gray-500">Ces CV défilent dans le fil (après la 3ᵉ offre), en bas de chaque offre et dans la vitrine plein écran (<a href="/cv/vitrine" class="font-semibold text-brand-600 hover:underline">/cv/vitrine</a>). Les premiers de la liste s'affichent en premier (<%= items.filter((i) => i.isActive).length %> affiché(s), 20 au maximum).</p>
  <p class="mt-2 text-xs text-gray-500">Vous pouvez afficher tout CV créé ou importé sur le site (prévu dans les Conditions et la Politique de confidentialité). Un membre peut refuser depuis son profil : son CV est alors retiré automatiquement. Les CV créés sur SenTravail sont publiés sans email, téléphone ni adresse ; un PDF importé est affiché tel quel. Les miniatures se préparent automatiquement sur cette page.</p>
</section>

<% if (!items.length) { %>
  <section class="card mb-3 rounded-lg px-4 py-8 text-center text-gray-500">Aucun CV dans la vitrine. Ajoutez-en depuis « Créés sur le site », « Importés » ou le formulaire ci-dessous.</section>
<% } else { %>
  <ul class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
    <% items.forEach((it, i) => { const gone = it.userId && (!it.user || it.user.cvShowcaseRefused || it.user.isBanned); %>
      <li class="card overflow-hidden rounded-lg">
        <div class="relative aspect-[9/16] max-h-64 w-full overflow-hidden bg-gray-100">
          <% if (it.thumbnail) { %>
            <img src="<%= it.thumbnail %>" alt="" loading="lazy" class="h-full w-full object-cover object-top">
          <% } else { %>
            <div class="flex h-full w-full items-center justify-center text-center text-xs text-gray-500" data-cv-thumb="/admin/cv/vitrine/<%= it.id %>/cv.pdf" data-upload="/admin/cv/vitrine/<%= it.id %>/images">
              <span data-thumb-msg>Préparation de la miniature…</span>
            </div>
          <% } %>
          <span class="absolute left-2 top-2 rounded-full px-2 py-0.5 text-[11px] font-semibold <%= !it.isActive || gone ? 'bg-gray-800 text-white' : 'bg-green-600 text-white' %>"><%= gone ? 'Refusé par le membre' : it.isActive ? 'Affiché' : 'Masqué' %></span>
        </div>
        <div class="space-y-2 p-2.5 text-sm">
          <div>
            <p class="truncate font-semibold"><%= it.name %></p>
            <p class="truncate text-xs text-gray-500"><%= it.title || '—' %><%= it.city ? ` · ${it.city}` : '' %></p>
            <p class="text-xs text-gray-500"><%= it.source === 'built' ? 'Créé sur SenTravail' : it.userId ? 'PDF du membre' : "Ajouté par l'admin" %> · <%= formatCount(it.viewsCount) %> vue(s)</p>
          </div>
          <div class="flex flex-wrap gap-1">
            <% const act = (a, label, extra = '') => `<form method="post" action="/admin/cv/vitrine/${it.id}" ${extra}><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="${a}"><button class="btn-light !px-2 !py-1 text-xs">${label}</button></form>`; %>
            <% if (i > 0) { %><%- act('up', '↑') %><% } %>
            <% if (i < items.length - 1) { %><%- act('down', '↓') %><% } %>
            <%- act('toggle', it.isActive ? 'Masquer' : 'Afficher') %>
            <% if (it.source === 'built' && it.userId) { %><%- act('refresh', 'Mettre à jour') %><% } %>
            <a href="/admin/cv/vitrine/<%= it.id %>/cv.pdf" target="_blank" rel="noopener" class="btn-light !px-2 !py-1 text-xs">PDF</a>
            <%- act('remove', 'Retirer', `x-data @submit="confirm('Retirer ce CV de la vitrine ?') || $event.preventDefault()"`) %>
          </div>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<section class="card rounded-lg p-4" aria-labelledby="add-title">
  <h2 id="add-title" class="text-lg font-semibold">Ajouter un CV (PDF)</h2>
  <p class="mb-3 text-sm text-gray-500">Pour une personne sans compte, ou un CV reçu par l'équipe. Le PDF est affiché tel quel (coordonnées comprises).</p>
  <form method="post" action="/admin/cv/vitrine/ajouter?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="space-y-3" novalidate>
    <div class="grid gap-3 sm:grid-cols-3">
      <div>
        <label for="cv-name" class="label">Nom affiché *</label>
        <input id="cv-name" name="name" value="<%= values.name || '' %>" maxlength="120" class="input <%= errors.name ? 'input-error' : '' %>" placeholder="Ex. Awa Ndiaye">
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>
      <div>
        <label for="cv-title" class="label">Métier / titre</label>
        <input id="cv-title" name="title" value="<%= values.title || '' %>" maxlength="120" class="input" placeholder="Ex. Comptable confirmée">
      </div>
      <div>
        <label for="cv-city" class="label">Ville</label>
        <input id="cv-city" name="city" value="<%= values.city || '' %>" maxlength="80" class="input" placeholder="Ex. Dakar">
      </div>
    </div>
    <div>
      <label for="cv-file" class="label">CV (PDF, 5 Mo max) *</label>
      <input id="cv-file" type="file" name="cv" accept="application/pdf,.pdf" class="block w-full text-sm <%= errors.cv ? 'text-red-600' : '' %>">
      <% if (errors.cv) { %><p class="field-error"><%= errors.cv %></p><% } %>
    </div>
    <div class="flex justify-end"><button class="btn-primary">Ajouter à la vitrine</button></div>
  </form>
</section>
