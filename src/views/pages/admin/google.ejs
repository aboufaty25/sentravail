<%- include('../../partials/adminNav') %>
<% const v = values || { analyticsId: g.analyticsId, siteVerification: g.siteVerification }; %>
<form method="post" action="/admin/google" class="space-y-3" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="card space-y-3 rounded-lg p-4" aria-labelledby="ga-title">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h2 id="ga-title" class="text-lg font-semibold">Google Analytics 4</h2>
        <p class="text-sm text-gray-500">Visiteurs, pages vues, provenance, appareils. Événements suivis : inscriptions, connexions, candidatures envoyées, clics sortants et recherches.</p>
      </div>
      <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= g.analyticsId ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-600' %>"><%= g.analyticsId ? 'Actif' : 'Non configuré' %></span>
    </div>
    <div>
      <label for="ga-id" class="label">ID de mesure</label>
      <input id="ga-id" name="analyticsId" value="<%= v.analyticsId %>" placeholder="G-XXXXXXXXXX" autocomplete="off" class="input <%= errors.analyticsId ? 'input-error' : '' %>">
      <% if (errors.analyticsId) { %><p class="field-error"><%= errors.analyticsId %></p><% } %>
    </div>
    <details class="rounded-lg bg-gray-50 p-3 text-sm text-gray-700">
      <summary class="cursor-pointer font-semibold">Où trouver l'ID de mesure ?</summary>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Ouvrez <a href="https://analytics.google.com" target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">analytics.google.com</a> avec votre compte Google.</li>
        <li><em>Administration → Créer → Propriété</em> : nom « SenTravail », fuseau horaire Dakar, devise XOF.</li>
        <li>Plateforme : <em>Web</em> → URL <code><%= appUrl %></code> → « Créer un flux ».</li>
        <li>Copiez l'<strong>ID de mesure</strong> (G-…) et collez-le ci-dessus.</li>
      </ol>
      <p class="mt-2">Les visites des pages d'administration ne sont pas comptées. Les premières données apparaissent dans « Temps réel » en quelques minutes.</p>
    </details>
  </section>

  <section class="card space-y-3 rounded-lg p-4" aria-labelledby="gsc-title">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h2 id="gsc-title" class="text-lg font-semibold">Google Search Console</h2>
        <p class="text-sm text-gray-500">Présence dans la recherche Google : mots-clés, clics, pages indexées, offres d'emploi (Google for Jobs).</p>
      </div>
      <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= g.siteVerification ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-600' %>"><%= g.siteVerification ? 'Balise en place' : 'Non configuré' %></span>
    </div>
    <div>
      <label for="gsc-code" class="label">Balise de validation (méthode « Balise HTML »)</label>
      <input id="gsc-code" name="siteVerification" value="<%= v.siteVerification %>" placeholder='<meta name="google-site-verification" content="…">' autocomplete="off" class="input <%= errors.siteVerification ? 'input-error' : '' %>">
      <% if (errors.siteVerification) { %><p class="field-error"><%= errors.siteVerification %></p><% } %>
      <p class="mt-1 text-xs text-gray-500">Collez la balise entière ou seulement le code : elle est ajoutée à la page d'accueil.</p>
    </div>
    <details class="rounded-lg bg-gray-50 p-3 text-sm text-gray-700">
      <summary class="cursor-pointer font-semibold">Comment valider le site ?</summary>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Ouvrez <a href="https://search.google.com/search-console" target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">Search Console</a> → <em>Ajouter une propriété</em> → <strong>Préfixe de l'URL</strong> : <code><%= appUrl %></code>.</li>
        <li>Méthode <strong>Balise HTML</strong> : copiez la balise, collez-la ici, enregistrez, puis cliquez sur « Valider » dans Search Console.</li>
        <li>Dans <em>Sitemaps</em>, ajoutez : <code><%= appUrl %>/sitemap.xml</code></li>
        <li>Les offres apparaîtront dans <em>Améliorations → Offres d'emploi</em> (données structurées déjà en place).</li>
      </ol>
    </details>
  </section>

  <div class="flex justify-end"><button class="btn-primary">Enregistrer</button></div>
</form>

<section class="card mt-3 space-y-3 rounded-lg p-4" aria-labelledby="idx-title">
  <div class="flex items-start justify-between gap-2">
    <div>
      <h2 id="idx-title" class="text-lg font-semibold">Google for Jobs : indexation immédiate</h2>
      <p class="text-sm text-gray-500">Chaque offre publiée, modifiée, approuvée, supprimée ou expirée est signalée aussitôt à Google (API d'indexation). Elle apparaît ainsi dans Google for Jobs en quelques heures au lieu de plusieurs jours.</p>
    </div>
    <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= indexing.enabled ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-600' %>"><%= indexing.enabled ? 'Actif' : 'Non configuré' %></span>
  </div>
  <% if (indexing.enabled) { %>
    <p class="break-words text-sm">Compte de service : <code><%= indexing.email %></code></p>
    <form method="post" action="/admin/google/indexation" class="flex flex-wrap items-center gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-soft">Envoyer toutes les offres ouvertes à Google</button>
      <span class="text-xs text-gray-500">Jusqu'à <%= indexing.limit %> offres (quota Google : 200 par jour).</span>
    </form>
  <% } else { %>
    <p class="rounded-lg bg-amber-50 p-3 text-sm text-amber-800">Inactif : <%= indexing.problem %>. Les offres restent visibles dans Google via le sitemap, mais plus lentement.</p>
  <% } %>
  <details class="rounded-lg bg-gray-50 p-3 text-sm text-gray-700" <%= indexing.enabled ? '' : 'open' %>>
    <summary class="cursor-pointer font-semibold">Comment l'activer ? (une seule fois, environ 10 minutes)</summary>
    <ol class="mt-2 list-decimal space-y-1 pl-5">
      <li>Ouvrez <a href="https://console.cloud.google.com/" target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">Google Cloud Console</a> (le même projet que la connexion Google convient).</li>
      <li><em>API et services → Bibliothèque</em> : cherchez <strong>Web Search Indexing API</strong> (« Indexing API ») → <em>Activer</em>.</li>
      <li><em>IAM et administration → Comptes de service → Créer</em> : nom « sentravail-indexing », aucun rôle à donner.</li>
      <li>Ouvrez le compte de service → <em>Clés → Ajouter une clé → JSON</em> : un fichier .json est téléchargé. <strong>Gardez-le secret</strong> : ne l'envoyez à personne.</li>
      <li>Dans <a href="https://search.google.com/search-console/users" target="_blank" rel="noopener" class="font-semibold text-brand-600 hover:underline">Search Console → Paramètres → Utilisateurs et autorisations</a> : <em>Ajouter un utilisateur</em> avec l'adresse du compte de service (…@….iam.gserviceaccount.com), autorisation <strong>Propriétaire</strong>.</li>
      <li>Sur Hostinger, déposez le fichier JSON <strong>hors de public_html</strong> (ex. <code>/home/u…/sentravail-private/indexing.json</code>) et ajoutez la variable d'environnement <code>GOOGLE_INDEXING_KEY_FILE</code> avec ce chemin. À défaut, copiez <code>client_email</code> dans <code>GOOGLE_INDEXING_CLIENT_EMAIL</code> et <code>private_key</code> dans <code>GOOGLE_INDEXING_PRIVATE_KEY</code>.</li>
      <li>Redémarrez l'application, revenez ici (« Actif ») et cliquez sur « Envoyer toutes les offres ouvertes à Google ».</li>
    </ol>
  </details>
  <% if (indexing.history.length) { %>
    <div>
      <h3 class="mb-1 text-sm font-semibold">Derniers envois</h3>
      <ul class="divide-y divide-gray-100 text-sm">
        <% indexing.history.forEach((h) => { %>
          <li class="flex flex-wrap items-baseline gap-x-2 py-1.5">
            <span class="font-semibold <%= h.ok ? 'text-green-700' : 'text-red-600' %>"><%= h.ok ? 'OK' : 'Échec' %></span>
            <span class="text-xs text-gray-500"><%= h.type === 'URL_DELETED' ? 'retrait' : 'mise à jour' %> · <%= formatDateTime(h.at) %></span>
            <a href="<%= h.url %>" class="min-w-0 break-all text-brand-600 hover:underline"><%= h.url.replace(appUrl, '') %></a>
            <% if (h.error) { %><span class="w-full text-xs text-red-600"><%= h.error %></span><% } %>
          </li>
        <% }) %>
      </ul>
      <p class="mt-1 text-xs text-gray-500">Historique de ce serveur depuis son dernier démarrage.</p>
    </div>
  <% } %>
</section>

<section class="card mt-3 space-y-3 rounded-lg p-4" aria-labelledby="signin-title">
  <h2 id="signin-title" class="text-lg font-semibold">Connexion avec Google et Apple</h2>
  <p class="text-sm text-gray-500">État des boutons « Continuer avec… » et dernière erreur rencontrée. Les valeurs secrètes ne sont jamais affichées.</p>
  <% signIn.forEach((p) => { %>
    <div class="space-y-2 rounded-lg border border-gray-200 p-3 text-sm">
      <div class="flex items-center justify-between gap-2">
        <h3 class="font-semibold"><%= p.label %></h3>
        <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= p.problem ? 'bg-gray-100 text-gray-600' : 'bg-green-50 text-green-700' %>"><%= p.problem ? 'Bouton masqué' : 'Bouton affiché' %></span>
      </div>
      <% if (p.problem) { %><p class="text-amber-800"><%= p.problem === 'not configured' ? 'Variables non renseignées.' : p.problem %></p><% } %>
      <p class="text-gray-700"><%= p.name === 'apple' ? 'Return URL (Services ID → Configure)' : 'URI de redirection autorisée' %> : <code class="break-all"><%= p.redirectUri %></code></p>
      <% if (p.name === 'apple') { %><p class="text-gray-700">Domaine (Domains and Subdomains) : <code><%= p.domain %></code></p><% } %>
      <% if (p.failure) { %>
        <div class="rounded-lg bg-red-50 p-2.5 text-red-800">
          <p><strong>Dernière erreur</strong> (<%= formatDateTime(p.failure.at) %>) : <code><%= p.failure.code %></code><% if (p.failure.detail) { %> — <%= p.failure.detail %><% } %></p>
          <% if (p.failure.hint) { %><p class="mt-1"><%= p.failure.hint %></p><% } %>
        </div>
      <% } else if (!p.problem) { %>
        <p class="text-gray-500">Aucune erreur enregistrée depuis la dernière connexion réussie.</p>
      <% } %>
    </div>
  <% }) %>
</section>
