<%- include('../../partials/adminNav') %>
<% const methods = { ninea: 'NINEA', rccm: 'RCCM', email: 'Email professionnel' }; %>
<% if (!requests.length) { %><section class="card rounded-lg px-4 py-10 text-center text-gray-500">Aucune demande de badge en attente.</section><% } %>
<ul class="space-y-3">
  <% requests.forEach(u => { %>
    <li class="card rounded-lg p-4" x-data="{ reject: false }">
      <div class="flex items-start gap-3">
        <%- avatar(u, 'w-11 h-11') %>
        <div class="min-w-0 flex-1">
          <a href="/profil/<%= u.username %>" class="font-semibold hover:underline"><%= u.companyName || `${u.firstName} ${u.lastName}` %></a>
          <p class="text-sm text-gray-600"><%= u.firstName %> <%= u.lastName %> · <%= u.email %></p>
          <p class="mt-1 text-sm"><span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-semibold"><%= methods[u.verificationMethod] %></span> <strong><%= u.verificationValue %></strong>
            <% if (u.verificationMethod === 'email') { %><span class="ml-1 text-xs font-semibold <%= u.verificationEmailConfirmed ? 'text-green-700' : 'text-amber-700' %>"><%= u.verificationEmailConfirmed ? 'adresse confirmée ✓' : 'adresse non encore confirmée' %></span><% } %></p>
          <p class="text-xs text-gray-500">Demandé le <%= formatDate(u.verificationRequestedAt) %></p>
        </div>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <form method="post" action="/admin/verifications/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="approve">
          <button class="btn-success !py-2" <%= u.verificationMethod === 'email' && !u.verificationEmailConfirmed ? 'disabled' : '' %>><%- icon('check', 'w-4 h-4') %> Accorder le badge</button></form>
        <button type="button" class="btn bg-red-50 !py-2 text-red-700 hover:bg-red-100" @click="reject = !reject">Refuser</button>
      </div>
      <form x-cloak x-show="reject" method="post" action="/admin/verifications/<%= u.id %>" class="mt-2 flex gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="reject">
        <input name="reason" maxlength="300" class="input !py-2" placeholder="Motif (envoyé au recruteur)">
        <button class="btn bg-red-600 !py-2 text-white hover:bg-red-700">Confirmer</button>
      </form>
    </li>
  <% }) %>
</ul>
<p class="mt-3 px-1 text-xs text-gray-500">Contrôlez le NINEA ou le RCCM auprès des registres officiels avant d'accorder le badge.</p>
