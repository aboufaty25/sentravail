<%- include('../../partials/adminNav') %>
<form method="get" action="/admin/utilisateurs" class="card mb-3 grid gap-2 rounded-lg p-3 sm:grid-cols-[1fr_auto_auto_auto]">
  <input name="q" value="<%= q %>" type="search" class="input !py-2" placeholder="Nom, email, téléphone, entreprise…" aria-label="Rechercher un utilisateur">
  <select name="role" class="input !py-2" aria-label="Rôle"><option value="">Tous les rôles</option>
    <% Object.entries({ candidate: 'Candidats', recruiter: 'Recruteurs', admin: 'Administrateurs' }).forEach(([k, l]) => { %><option value="<%= k %>" <%= role === k ? 'selected' : '' %>><%= l %></option><% }) %></select>
  <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="statut" value="bannis" <%= banned ? 'checked' : '' %>> Suspendus</label>
  <button class="btn-primary !py-2">Filtrer</button>
</form>
<ul class="card divide-y divide-gray-100 rounded-lg">
  <% if (!users.length) { %><li class="p-6 text-center text-gray-500">Aucun utilisateur.</li><% } %>
  <% users.forEach(u => { const self = u.id === currentUser.id; %>
    <li class="flex flex-wrap items-center gap-3 px-4 py-3" x-data="{ open: false }">
      <a href="/profil/<%= u.username %>"><%- avatar(u, 'w-10 h-10') %></a>
      <div class="min-w-0 flex-1">
        <p class="font-semibold"><a href="/profil/<%= u.username %>" class="hover:underline"><%= u.firstName %> <%= u.lastName %></a>
          <% if (u.isVerified) { %><span class="text-brand-600" title="Vérifié">✓</span><% } %>
          <% if (u.isBanned) { %><span class="ml-1 rounded bg-red-100 px-1.5 text-xs font-semibold text-red-700">Suspendu</span><% } %></p>
        <p class="truncate text-sm text-gray-500"><%= u.email %><%= u.phone ? ` · ${u.phone}` : '' %></p>
        <p class="text-xs text-gray-400"><%= roleLabel(u.role) %><%= u.companyName ? ` · ${u.companyName}` : '' %> · inscrit le <%= formatDate(u.createdAt) %><%= reportCounts[u.id] ? ` · ${reportCounts[u.id]} signalement(s)` : '' %></p>
      </div>
      <% if (!self) { %>
        <button type="button" class="btn-light !py-1.5 text-sm" @click="open = !open" :aria-expanded="open">Gérer</button>
        <div x-cloak x-show="open" class="flex w-full flex-wrap gap-2 rounded-lg bg-gray-50 p-2">
          <% const act = (action, label, cls, extra = '') => `<form method="post" action="/admin/utilisateurs/${u.id}"${extra}><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="${action}"><button class="btn ${cls} !py-1.5 text-sm">${label}</button></form>`; %>
          <% if (u.isBanned) { %><%- act('unban', 'Réactiver', 'btn-success') %><% } else if (u.role !== 'admin') { %><%- act('ban', 'Suspendre', 'bg-red-600 text-white hover:bg-red-700', ` x-data @submit="confirm('Suspendre ce compte ?') || $event.preventDefault()"`) %><% } %>
          <%- act(u.isVerified ? 'unverify' : 'verify', u.isVerified ? 'Retirer le badge vérifié' : 'Ajouter le badge vérifié', 'bg-white ring-1 ring-gray-200') %>
          <form method="post" action="/admin/utilisateurs/<%= u.id %>" class="flex gap-1">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="role">
            <select name="role" class="rounded-md border border-gray-300 px-2 text-sm" aria-label="Rôle">
              <% [['candidate', 'Candidat'], ['recruiter', 'Recruteur'], ['admin', 'Administrateur']].forEach(([k, l]) => { %><option value="<%= k %>" <%= u.role === k ? 'selected' : '' %>><%= l %></option><% }) %>
            </select>
            <button class="btn bg-white !py-1.5 text-sm ring-1 ring-gray-200">Changer le rôle</button>
          </form>
        </div>
      <% } else { %><span class="text-xs text-gray-400">Vous</span><% } %>
    </li>
  <% }) %>
</ul>
