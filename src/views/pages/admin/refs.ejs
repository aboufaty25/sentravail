<%- include('../../partials/adminNav') %>
<div class="grid gap-3 lg:grid-cols-2">
  <% [['city', 'Villes', cities], ['sector', 'Secteurs', sectors]].forEach(([kind, label, items]) => { %>
    <section class="card rounded-lg p-4" aria-label="<%= label %>">
      <h2 class="text-lg font-semibold"><%= label %> <span class="text-sm font-normal text-gray-500">(<%= items.filter(i => i.active).length %> actives)</span></h2>
      <form method="post" action="/admin/referentiels" class="mt-3 flex gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="<%= kind %>">
        <input name="name" required maxlength="80" class="input !py-2" placeholder="<%= kind === 'city' ? 'Nouvelle ville' : 'Nouveau secteur' %>" aria-label="<%= kind === 'city' ? 'Nouvelle ville' : 'Nouveau secteur' %>">
        <button class="btn-primary !py-2">Ajouter</button>
      </form>
      <ul class="mt-3 divide-y divide-gray-100">
        <% items.forEach(i => { %>
          <li class="flex items-center gap-2 py-2" x-data="{ edit: false }">
            <span x-show="!edit" class="flex-1 <%= i.active ? '' : 'text-gray-400 line-through' %>"><%= i.name %></span>
            <form x-cloak x-show="edit" method="post" action="/admin/referentiels/<%= i.id %>" class="flex flex-1 gap-1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="rename">
              <input name="name" value="<%= i.name %>" maxlength="80" class="input !py-1.5" aria-label="Nouveau nom"><button class="btn-primary !py-1.5 text-sm">OK</button>
            </form>
            <button type="button" class="text-sm font-semibold text-brand-600 hover:underline" @click="edit = !edit" x-text="edit ? 'Annuler' : 'Renommer'"></button>
            <form method="post" action="/admin/referentiels/<%= i.id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="toggle">
              <button class="text-sm font-semibold <%= i.active ? 'text-red-600' : 'text-green-700' %> hover:underline"><%= i.active ? 'Désactiver' : 'Réactiver' %></button>
            </form>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
</div>
<p class="mt-3 px-1 text-xs text-gray-500">Une valeur désactivée n'est plus proposée dans les formulaires et filtres, mais les offres et profils existants la conservent. Renommer met à jour les offres et profils concernés.</p>
