<div class="card min-h-[calc(100vh-8rem)] sm:min-h-0 sm:rounded-lg" x-data="composer()">
  <form @submit.prevent="submit($el)" action="/publier" method="post" enctype="multipart/form-data" novalidate>
    <div class="flex items-center gap-2 border-b border-gray-200 px-3 py-2">
      <a href="/" class="icon-btn !bg-transparent" aria-label="Annuler"><%- icon('arrowLeft', 'w-5 h-5') %></a>
      <h1 class="flex-1 text-lg font-semibold">Créer une publication</h1>
      <button type="submit" class="btn-primary !px-5 !py-1.5" :disabled="sending || (!text.trim() && !files.length)">
        <span x-show="!sending">Publier</span><span x-cloak x-show="sending">Envoi…</span>
      </button>
    </div>


    <div class="flex items-center gap-2 px-3 pt-3">
      <%- avatar(currentUser, 'w-10 h-10') %>
      <div>
        <p class="font-semibold leading-tight"><%= currentUser.fullName %></p>
        <label class="mt-0.5 inline-flex items-center gap-1 rounded-md bg-gray-200 px-2 py-0.5 text-xs font-semibold text-gray-700">
          <span class="sr-only">Visibilité</span>
          <select name="visibility" class="bg-transparent focus:outline-none">
            <option value="public">🌍 Public</option>
            <option value="network">👥 Mon réseau</option>
          </select>
        </label>
      </div>
    </div>

    <label for="post-text" class="sr-only">Votre publication</label>
    <textarea id="post-text" name="text" x-model="text" maxlength="5000" rows="5" autofocus
      class="block w-full resize-none px-3 py-3 text-lg placeholder-gray-500 focus:outline-none"
      :class="text.length > 120 || files.length ? 'text-base' : 'text-xl'"
      placeholder="Partagez une actualité, un conseil, une réussite…"
      @input="$el.style.height = 'auto'; $el.style.height = Math.max(120, $el.scrollHeight) + 'px'"><%= values.text || '' %></textarea>

    <div x-cloak x-show="previews.length" class="grid gap-1 px-3" :class="previews.length > 1 ? 'grid-cols-2' : ''">
      <template x-for="(src, i) in previews" :key="src">
        <div class="relative">
          <img :src="src" alt="" class="w-full rounded-md object-cover" :class="previews.length > 1 ? 'aspect-square' : 'max-h-96'">
          <button type="button" @click="remove(i)" class="absolute right-1 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-gray-800 shadow" aria-label="Retirer la photo"><%- icon('x', 'w-4 h-4') %></button>
        </div>
      </template>
    </div>

    <p x-cloak x-show="error" x-text="error" class="mx-3 mt-2 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
    <% if (errors.text) { %><p class="mx-3 mt-2 field-error"><%= errors.text %></p><% } %>

    <div class="m-3 flex items-center justify-between rounded-lg border border-gray-300 px-3 py-2">
      <span class="text-[15px] font-semibold">Ajouter à votre publication</span>
      <label class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-green-600 hover:bg-gray-100" title="Une image (2 Mo max.)">
        <%- icon('photo', 'w-7 h-7') %>
        <span class="sr-only">Ajouter des photos</span>
        <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" @change="add($event)" <%= type === 'photo' ? 'x-init="$nextTick(() => $el.click())"' : '' %>>
      </label>
    </div>
  </form>
</div>
