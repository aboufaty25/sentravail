<div class="card rounded-lg p-4 sm:p-6">
  <h1 class="text-xl font-semibold">Mot de passe oublié</h1>
  <% if (sent) { %>
    <p class="mt-3 rounded-md bg-green-50 px-3 py-3 text-sm text-green-800" role="status">Si un compte existe avec cette adresse, vous allez recevoir un email avec un lien pour choisir un nouveau mot de passe.</p>
    <a href="/connexion" class="btn-primary mt-4 w-full">Retour à la connexion</a>
  <% } else { %>
    <p class="mb-4 mt-1 text-sm text-gray-500">Saisissez l'adresse email de votre compte. Nous vous enverrons un lien de réinitialisation.</p>
    <form method="post" action="/mot-de-passe-oublie" class="space-y-3" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../partials/field', { name: 'email', type: 'email', label: 'Email', placeholder: 'vous@exemple.com', autocomplete: 'email', required: true }) %>
      <div class="flex justify-end gap-2">
        <a href="/connexion" class="btn-light">Annuler</a>
        <button type="submit" class="btn-primary">Envoyer le lien</button>
      </div>
    </form>
  <% } %>
</div>
