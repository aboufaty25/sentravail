<div class="card rounded-lg p-4 sm:p-6">
  <h1 class="text-xl font-semibold">Nouveau mot de passe</h1>
  <% if (!valid) { %>
    <p class="mt-3 rounded-md bg-red-50 px-3 py-3 text-sm text-red-700" role="alert">Ce lien est invalide ou a expiré.</p>
    <a href="/mot-de-passe-oublie" class="btn-primary mt-4 w-full">Demander un nouveau lien</a>
  <% } else { %>
    <form method="post" action="/reinitialiser/<%= token %>" class="mt-4 space-y-3" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../../partials/field', { name: 'password', type: 'password', label: 'Nouveau mot de passe', placeholder: '8 caractères minimum', autocomplete: 'new-password', required: true }) %>
      <%- include('../../partials/field', { name: 'passwordConfirm', type: 'password', label: 'Confirmer le mot de passe', autocomplete: 'new-password', required: true }) %>
      <button type="submit" class="btn-primary w-full !py-3">Enregistrer</button>
    </form>
  <% } %>
</div>
