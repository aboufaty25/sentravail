<div class="card rounded-lg p-4 sm:p-6" x-data="{ role: '<%= values.role === 'recruiter' ? 'recruiter' : values.role === 'candidate' ? 'candidate' : '' %>' }">
  <h1 class="text-xl font-semibold">Finaliser l'inscription</h1>
  <p class="mb-4 text-sm text-gray-500">Connecté avec <%= provider %> : <strong class="break-all text-gray-700"><%= email %></strong>. Encore une étape pour créer votre compte.</p>
  <form method="post" action="/inscription/finaliser" class="space-y-3" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/roleChoice', { noDefaultRole: true }) %>
    <div class="grid grid-cols-2 gap-2">
      <%- include('../../partials/field', { name: 'firstName', label: 'Prénom', placeholder: 'Prénom', autocomplete: 'given-name', required: true }) %>
      <%- include('../../partials/field', { name: 'lastName', label: 'Nom', placeholder: 'Nom', autocomplete: 'family-name', required: true }) %>
    </div>
    <div x-show="role === 'recruiter'" x-cloak>
      <%- include('../../partials/field', { name: 'companyName', label: "Nom de l'entreprise", placeholder: 'Nom de votre entreprise', autocomplete: 'organization' }) %>
    </div>
    <%- include('../../partials/field', { name: 'phone', type: 'tel', label: 'Téléphone (facultatif)', placeholder: '77 123 45 67', autocomplete: 'tel', inputmode: 'tel' }) %>
    <label class="flex items-start gap-2 text-sm text-gray-600">
      <input type="checkbox" name="acceptTerms" class="mt-1 h-4 w-4 rounded border-gray-300" <%= values.acceptTerms ? 'checked' : '' %>>
      <span>J'accepte les <a href="/conditions" class="text-brand-600 hover:underline" target="_blank">conditions d'utilisation</a> et la <a href="/confidentialite" class="text-brand-600 hover:underline" target="_blank">politique de confidentialité</a>.</span>
    </label>
    <% if (errors.acceptTerms) { %><p class="field-error"><%= errors.acceptTerms %></p><% } %>
    <button type="submit" class="btn-success w-full !py-3 text-lg">Créer mon compte</button>
  </form>
  <p class="mt-4 text-center text-sm"><a href="/inscription" class="text-gray-500 hover:underline">Annuler</a></p>
</div>
