<div class="px-3 sm:px-0">
  <h1 class="mb-2 text-2xl font-bold">Menu</h1>
  <% if (currentUser) { %>
    <div class="card rounded-lg p-2"><%- include('../partials/menuList') %></div>
  <% } else { %>
    <div class="card rounded-lg p-4">
      <p class="font-semibold">Rejoignez SenTravail</p>
      <p class="mt-1 text-sm text-gray-500">Publiez votre recherche d'emploi, suivez les recruteurs, créez votre CV et suivez vos candidatures.</p>
      <div class="mt-3 grid grid-cols-2 gap-2"><a href="/inscription" class="btn-success !py-2 text-sm">Créer un compte</a><a href="/connexion" class="btn-light !py-2 text-sm">Se connecter</a></div>
    </div>
    <nav class="card mt-2 rounded-lg p-2" aria-label="Rubriques">
      <a href="/offres" class="menu-item"><span class="text-brand-600"><%- icon('briefcase') %></span> Offres d'emploi</a>
      <a href="/evenements" class="menu-item"><span class="text-orange-600"><%- icon('calendar') %></span> Événements emploi</a>
      <a href="/recherche" class="menu-item"><span class="text-gray-600"><%- icon('search') %></span> Rechercher</a>
      <button type="button" class="menu-item w-full" data-login="Connectez-vous pour créer votre CV gratuitement."><span class="text-brand-600"><%- icon('document') %></span> Créer mon CV</button>
    </nav>
  <% } %>
  <p class="mt-4 px-2 text-xs leading-6 text-gray-500">
    <a href="/a-propos" class="hover:underline">À propos</a> · <a href="/contact" class="hover:underline">Contact</a> ·
    <a href="/confidentialite" class="hover:underline">Confidentialité</a> · <a href="/conditions" class="hover:underline">Conditions</a>
  </p>
</div>
