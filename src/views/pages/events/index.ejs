<div class="space-y-2 sm:space-y-4">
  <section class="card px-3 py-3 sm:px-4">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold">Événements emploi</h1>
      <% if (currentUser) { %><a href="/publier/evenement" class="btn-primary !py-1.5 text-sm"><%- icon('plus', 'w-4 h-4') %> Publier</a><% } %>
    </div>
    <p class="mt-1 text-sm text-gray-500">Salons de recrutement, concours, portes ouvertes et formations à venir.</p>
    <form method="get" action="/evenements" class="mt-3 grid grid-cols-2 gap-2">
      <select name="ville" class="input !py-2" x-data @change="$el.form.requestSubmit()" aria-label="Ville">
        <option value="">Toutes les villes</option><% CITIES.forEach(c => { %><option <%= ville === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
      <select name="type" class="input !py-2" x-data @change="$el.form.requestSubmit()" aria-label="Type">
        <option value="">Tous les types</option><% Object.entries(EVENT_KINDS).forEach(([k, l]) => { %><option value="<%= k %>" <%= type === k ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
    </form>
  </section>
  <% if (!posts.length) { %>
    <section class="card px-4 py-10 text-center">
      <span class="mx-auto block w-fit text-orange-500"><%- icon('calendar', 'w-12 h-12') %></span>
      <p class="mt-3 font-semibold">Aucun événement à venir<%= ville ? ` à ${ville}` : '' %></p>
      <p class="mt-1 text-sm text-gray-500">Vous organisez un salon, un concours ou une formation ? Annoncez-le ici.</p>
    </section>
  <% } %>
  <% posts.forEach(post => { %><%- include('../../partials/postCard', { post }) %><% }) %>
</div>
