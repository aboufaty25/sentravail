<div class="card min-h-[calc(100vh-8rem)] sm:min-h-0 sm:rounded-lg" x-data="reelComposer(<%= maxSeconds %>)">
  <form @submit.prevent="submit($el)" novalidate>
    <div class="flex items-center gap-2 border-b border-gray-200 px-3 py-2">
      <a href="/reels" class="icon-btn !bg-transparent" aria-label="Annuler"><%- icon('arrowLeft', 'w-5 h-5') %></a>
      <h1 class="flex-1 text-lg font-semibold">Publier un réel</h1>
      <button type="submit" class="btn-primary !px-5 !py-1.5" :disabled="!file || sending || checking">
        <span x-show="!sending">Publier</span><span x-cloak x-show="sending" x-text="progress + ' %'"></span>
      </button>
    </div>

    <div class="px-3 py-3 space-y-3">
      <template x-if="!previewUrl">
        <label class="flex aspect-[9/16] max-h-[60vh] w-full cursor-pointer flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 text-center hover:border-brand-500">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-rose-100 text-rose-600"><%- icon('video', 'w-8 h-8') %></span>
          <span class="font-semibold">Choisir une vidéo</span>
          <span class="px-6 text-sm text-gray-500">Vidéo verticale de <%= maxSeconds %> secondes maximum (MP4 ou MOV, 40 Mo max.)</span>
          <input type="file" accept="video/mp4,video/quicktime,video/x-m4v,video/*" class="sr-only" @change="pick($event)">
        </label>
      </template>
      <template x-if="previewUrl">
        <div class="relative mx-auto aspect-[9/16] max-h-[60vh] overflow-hidden rounded-xl bg-black">
          <video :src="previewUrl" class="h-full w-full object-contain" controls playsinline muted></video>
          <button type="button" @click="reset()" class="absolute right-2 top-2 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-gray-800" aria-label="Retirer la vidéo"><%- icon('x', 'w-5 h-5') %></button>
          <span class="absolute bottom-2 left-2 rounded bg-black/60 px-2 py-0.5 text-xs font-semibold text-white" x-text="Math.round(duration) + ' s'"></span>
        </div>
      </template>
      <p x-cloak x-show="checking" class="text-sm text-gray-500">Vérification de la vidéo…</p>
      <p x-cloak x-show="error" x-text="error" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>

      <div x-cloak x-show="sending" class="h-2 overflow-hidden rounded-full bg-gray-200" role="progressbar" :aria-valuenow="progress" aria-valuemin="0" aria-valuemax="100">
        <div class="h-full bg-brand-600 transition-all" :style="`width: ${progress}%`"></div>
      </div>

      <label for="reel-text" class="sr-only">Description</label>
      <textarea id="reel-text" name="text" x-model="text" rows="2" maxlength="2000" class="input resize-none" placeholder="Décrivez votre réel… (ex. Mon métier en 30 secondes)"></textarea>
      <label class="flex items-center gap-2 text-sm"><span class="text-gray-600">Visibilité :</span>
        <select name="visibility" x-model="visibility" class="rounded-md border border-gray-300 bg-white px-2 py-1">
          <option value="public">🌍 Public</option><option value="network">👥 Mon réseau</option>
        </select></label>
      <p class="text-xs text-gray-500">Conseil : filmez à la verticale, en 720p, avec une bonne lumière. Votre vidéo est envoyée telle quelle : une vidéo plus courte s'envoie plus vite en 3G.</p>
    </div>
  </form>
</div>
