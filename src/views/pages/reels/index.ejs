<div x-data="reelsViewer()" class="relative">
  <div class="h-[100dvh] snap-y snap-mandatory overflow-y-scroll overscroll-contain [scrollbar-width:none]" x-ref="scroller">
    <% if (!reels.length) { %>
      <section class="flex h-[100dvh] flex-col items-center justify-center gap-3 px-6 text-center">
        <span class="text-white/60"><%- icon('play', 'w-14 h-14') %></span>
        <p class="text-lg font-semibold">Aucun réel pour le moment</p>
        <p class="text-sm text-white/70">Soyez le premier à présenter votre métier en 30 secondes !</p>
        <% if (currentUser) { %><a href="/reels/nouveau" class="btn-primary">Publier un réel</a><% } %>
      </section>
    <% } %>
    <%- include('../../partials/reelSlides', { reels, hasMore, page, firstId }) %>
  </div>

  <%# Comments bottom sheet %>
  <div x-cloak x-show="commentsFor" x-transition.opacity class="fixed inset-0 z-40 bg-black/50" @click="closeComments()"></div>
  <div x-cloak x-show="commentsFor" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="translate-y-full" x-transition:enter-end="translate-y-0"
    class="fixed inset-x-0 bottom-0 z-40 flex max-h-[75dvh] flex-col rounded-t-2xl bg-white text-gray-900 sm:inset-x-auto sm:left-1/2 sm:w-[480px] sm:-translate-x-1/2" role="dialog" aria-modal="true" aria-label="Commentaires">
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
      <h2 class="font-semibold">Commentaires</h2>
      <button type="button" class="icon-btn" @click="closeComments()" aria-label="Fermer"><%- icon('x', 'w-5 h-5') %></button>
    </div>
    <div id="reel-comments-body" class="flex-1 overflow-y-auto"></div>
  </div>
</div>
