<%# Full-screen CV viewer, like Facebook Reels: one CV per screen, swipe up/down on a phone,
    arrows (and keyboard) on a computer; actions in a column on the right. %>
<div class="fixed inset-0 bg-black text-white" data-reels-viewer data-start="<%= startId || '' %>">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between bg-gradient-to-b from-black/70 to-transparent px-3 pb-6 pt-[max(0.75rem,env(safe-area-inset-top))]">
    <a href="/" class="pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Fermer" data-reels-close><%- icon('x', 'w-6 h-6') %></a>
    <h1 class="text-lg font-bold">Vitrine des CV</h1>
    <a href="/cv/creer" <%- loginAttr(currentUser, 'Connectez-vous pour créer votre CV.') %> class="pointer-events-auto inline-flex h-10 items-center gap-1 rounded-full bg-white/10 px-3 text-sm font-semibold hover:bg-white/20"><%- icon('plus', 'w-4 h-4') %> Mon CV</a>
  </div>

  <% if (!items.length) { %>
    <div class="flex h-full flex-col items-center justify-center px-6 text-center">
      <span class="text-white/60"><%- icon('document', 'w-14 h-14') %></span>
      <p class="mt-3 text-lg font-semibold">Aucun CV dans la vitrine pour le moment.</p>
      <a href="/cv/creer" class="btn-primary mt-4">Créer mon CV</a>
    </div>
  <% } else { %>
  <div class="h-full snap-y snap-mandatory overflow-y-auto overscroll-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reels-scroller>
    <% items.forEach(({ r, thumbnail, image }, i) => {
         const share = `${appUrl}/cv/vitrine?id=${r.id}`;
         // Complete CV with contact details: recruiters and admins; public copy without contacts: builder CVs only.
         const pdf = seesContacts ? `/cv/vitrine/${r.id}/complet` : r.source === 'built' ? `/cv/vitrine/${r.id}/cv.pdf` : null; %>
    <section id="cv-<%= r.id %>" class="relative flex h-[100dvh] snap-start snap-always items-center justify-center sm:py-4" aria-label="CV de <%= r.name %>">
      <%# Nothing is drawn over the CV: the page sits at the top, name and actions below it. %>
      <div class="flex h-full w-full flex-col overflow-hidden bg-neutral-900 pt-[max(4rem,calc(env(safe-area-inset-top)+3.5rem))] sm:aspect-[9/16] sm:w-auto sm:rounded-xl sm:pt-14">
        <div class="flex min-h-0 flex-1 items-start justify-center px-2">
          <% if (image || thumbnail) { %>
            <img src="<%= image || thumbnail %>" alt="CV de <%= r.name %>" <%= i < 2 ? '' : 'loading=lazy' %> decoding="async" class="max-h-full max-w-full rounded-md bg-white object-contain shadow-2xl">
          <% } else { %>
            <div class="flex aspect-[1/1.414] h-full max-w-full items-center justify-center rounded-md" style="background: linear-gradient(160deg, <%= /^#[0-9a-fA-F]{6}$/.test(r.color || '') ? r.color : '#1668e3' %>, #111827)">
              <span class="text-white/70"><%- icon('document', 'w-20 h-20') %></span>
            </div>
          <% } %>
        </div>
        <div class="shrink-0 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3">
          <div class="flex items-center gap-3">
            <% if (r.user) { %><a href="/profil/<%= r.user.username %>" class="shrink-0 rounded-full ring-2 ring-white" aria-label="Profil de <%= r.name %>"><%- avatar(r.user, 'w-10 h-10', 'text-sm') %></a><% } %>
            <div class="min-w-0">
              <p class="flex items-center gap-1.5 truncate text-[15px] font-bold"><%= r.name %><% if (r.user && r.user.isVerified) { %> <%- verifiedBadge('w-4 h-4') %><% } %></p>
              <p class="truncate text-sm text-white/80"><%= [r.title, r.city].filter(Boolean).join(' · ') %></p>
            </div>
          </div>
          <%# Actions, like the buttons of a reel. %>
          <div class="mt-3 flex items-center gap-2">
            <% if (pdf) { %><a href="<%= pdf %>" target="_blank" rel="noopener" class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-100"><%- icon('document', 'w-4 h-4') %> <%= seesContacts ? 'Voir le CV complet' : 'Voir le CV' %></a><% } %>
            <% if (r.user) { %><a href="/profil/<%= r.user.username %>" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" aria-label="Profil"><%- icon('user', 'w-5 h-5') %></a><% } %>
            <button type="button" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" data-share-native="<%= share %>" data-share-title="CV de <%= r.name %> — SenTravail" aria-label="Partager"><%- icon('share', 'w-5 h-5') %></button>
            <span class="inline-flex h-10 shrink-0 items-center gap-1 rounded-full bg-white/15 px-3 text-sm font-semibold" aria-label="<%= r.viewsCount %> vues"><%- icon('eye', 'w-4 h-4') %> <%= formatCount(r.viewsCount) %></span>
          </div>
          <% if (!seesContacts) { %>
            <p class="mt-2 text-xs text-white/70">Email et téléphone visibles par les recruteurs vérifiés.<% if (!currentUser) { %> <a href="/connexion?retour=<%= encodeURIComponent(`/cv/vitrine?id=${r.id}`) %>" class="font-semibold text-white underline">Je suis recruteur</a><% } else if (currentUser.role === 'recruiter') { %> <a href="/parametres/verification" class="font-semibold text-white underline">Obtenir le badge vérifié</a><% } %></p>
          <% } %>
        </div>
      </div>
    </section>
    <% }) %>
  </div>
  <%# Computer: previous / next buttons on the right, like Facebook Reels. %>
  <div class="absolute right-6 top-1/2 z-20 hidden -translate-y-1/2 flex-col gap-3 sm:flex">
    <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" data-reels-up aria-label="CV précédent"><span class="-rotate-90"><%- icon('chevronRight', 'w-6 h-6') %></span></button>
    <button type="button" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" data-reels-down aria-label="CV suivant"><span class="rotate-90"><%- icon('chevronRight', 'w-6 h-6') %></span></button>
  </div>
  <% } %>
</div>
