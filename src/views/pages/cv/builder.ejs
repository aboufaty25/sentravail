<%
  const steps = ['Infos', 'Titre', 'Expériences', 'Formations', 'Compétences', 'Langues', 'Modèle'];
  const cfg = JSON.stringify({ initial, loggedIn: !!currentUser, userKey: currentUser ? currentUser.id : 'guest', returnTo, levels: LANGUAGE_LEVELS }).replace(/</g, '\\u003c');
%>
<div x-data="cvBuilder(<%= cfg %>)">
  <div class="card mb-2 px-3 py-3 sm:rounded-lg sm:px-4">
    <div class="flex items-center gap-2">
      <a href="<%= returnTo || '/cv' %>" class="icon-btn !bg-transparent" aria-label="Retour"><%- icon('arrowLeft', 'w-5 h-5') %></a>
      <h1 class="flex-1 text-lg font-semibold">Créer mon CV</h1>
      <span class="text-xs text-gray-500" x-show="savedDraft" x-transition>Brouillon enregistré</span>
    </div>
    <ol class="mt-3 flex gap-1" aria-label="Étapes">
      <% steps.forEach((s, i) => { %>
        <li class="flex-1"><button type="button" @click="go(<%= i %>)" class="block w-full text-left" :aria-current="step === <%= i %> ? 'step' : null">
          <span class="block h-1.5 rounded-full" :class="step >= <%= i %> ? 'bg-brand-600' : 'bg-gray-200'"></span>
          <span class="mt-1 hidden text-[11px] font-medium sm:block" :class="step === <%= i %> ? 'text-brand-700' : 'text-gray-500'"><%= s %></span>
        </button></li>
      <% }) %>
    </ol>
    <div class="mt-3 grid grid-cols-2 gap-1 rounded-lg bg-gray-100 p-1 text-sm font-semibold lg:hidden" role="tablist">
      <button type="button" role="tab" @click="tab = 'edit'" :class="tab === 'edit' ? 'bg-white shadow' : 'text-gray-600'" class="rounded-md py-1.5">Modifier</button>
      <button type="button" role="tab" @click="tab = 'preview'" :class="tab === 'preview' ? 'bg-white shadow' : 'text-gray-600'" class="rounded-md py-1.5">Aperçu</button>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <section class="card px-4 py-4 sm:rounded-lg" :class="tab === 'edit' ? '' : 'hidden lg:block'">
      <%# 1. Personal %>
      <div x-show="step === 0" class="space-y-3">
        <h2 class="text-lg font-semibold">Informations personnelles</h2>
        <div class="flex items-center gap-3">
          <template x-if="cv.personal.photoUrl"><img :src="cv.personal.photoUrl" alt="" class="h-16 w-16 rounded-full object-cover"></template>
          <template x-if="!cv.personal.photoUrl"><span class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-400"><%- icon('user', 'w-8 h-8') %></span></template>
          <label class="btn-light cursor-pointer text-sm"><span x-text="uploading ? 'Envoi…' : (cv.personal.photoUrl ? 'Changer la photo' : 'Ajouter une photo')"></span>
            <input type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" @change="uploadPhoto($event)"></label>
          <button type="button" x-show="cv.personal.photoUrl" class="text-sm text-red-600 hover:underline" @click="cv.personal.photoUrl = ''">Retirer</button>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="cv-fn">Prénom *</label><input id="cv-fn" class="input" x-model="cv.personal.firstName" autocomplete="given-name"></div>
          <div><label class="label" for="cv-ln">Nom *</label><input id="cv-ln" class="input" x-model="cv.personal.lastName" autocomplete="family-name"></div>
        </div>
        <div><label class="label" for="cv-em">Email *</label><input id="cv-em" type="email" class="input" x-model="cv.personal.email" autocomplete="email"></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="cv-ph">Téléphone</label><input id="cv-ph" type="tel" class="input" x-model="cv.personal.phone" autocomplete="tel" placeholder="77 123 45 67"></div>
          <div><label class="label" for="cv-ci">Ville</label><input id="cv-ci" class="input" x-model="cv.personal.city" placeholder="Dakar"></div>
        </div>
      </div>

      <%# 2. Title & summary %>
      <div x-show="step === 1" class="space-y-3">
        <h2 class="text-lg font-semibold">Titre et profil</h2>
        <div><label class="label" for="cv-title">Titre professionnel *</label><input id="cv-title" class="input" x-model="cv.title" maxlength="120" placeholder="Ex. Comptable — 5 ans d'expérience"></div>
        <div><label class="label" for="cv-sum">Profil (facultatif)</label>
          <textarea id="cv-sum" rows="6" maxlength="1200" class="input" x-model="cv.summary" placeholder="En 3 ou 4 phrases : qui vous êtes, ce que vous savez faire, ce que vous recherchez."></textarea>
          <p class="mt-1 text-right text-xs text-gray-400"><span x-text="cv.summary.length"></span>/1200</p></div>
      </div>

      <%# 3. Experiences %>
      <div x-show="step === 2" class="space-y-3">
        <h2 class="text-lg font-semibold">Expériences professionnelles</h2>
        <p class="text-sm text-gray-500" x-show="!cv.experiences.length">Stages, emplois, bénévolat… Commencez par le plus récent.</p>
        <template x-for="(e, i) in cv.experiences" :key="e._id">
          <div class="space-y-2 rounded-lg border border-gray-200 p-3">
            <div class="flex items-center justify-between"><p class="font-semibold" x-text="e.title || 'Nouvelle expérience'"></p>
              <div class="flex gap-1">
                <button type="button" class="icon-btn !h-8 !w-8 !bg-transparent" @click="move(cv.experiences, i, -1)" :disabled="i === 0" aria-label="Monter">↑</button>
                <button type="button" class="icon-btn !h-8 !w-8 !bg-transparent text-red-600" @click="cv.experiences.splice(i, 1)" aria-label="Supprimer"><%- icon('trash', 'w-4 h-4') %></button>
              </div></div>
            <input class="input" x-model="e.title" placeholder="Intitulé du poste *" maxlength="120">
            <div class="grid grid-cols-2 gap-2"><input class="input" x-model="e.company" placeholder="Entreprise" maxlength="120"><input class="input" x-model="e.city" placeholder="Ville" maxlength="80"></div>
            <div class="grid grid-cols-2 gap-2">
              <label class="text-xs text-gray-500">Début<input type="month" class="input mt-0.5" x-model="e.start"></label>
              <label class="text-xs text-gray-500">Fin<input type="month" class="input mt-0.5" x-model="e.end" :disabled="e.current"></label>
            </div>
            <label class="flex items-center gap-2 text-sm"><input type="checkbox" x-model="e.current" class="h-4 w-4"> Poste actuel</label>
            <textarea rows="3" class="input" x-model="e.description" maxlength="1500" placeholder="Missions et résultats (une ligne par point)"></textarea>
          </div>
        </template>
        <button type="button" class="btn-soft w-full" @click="addExperience()" x-show="cv.experiences.length < 10"><%- icon('plus', 'w-4 h-4') %> Ajouter une expérience</button>
      </div>

      <%# 4. Education %>
      <div x-show="step === 3" class="space-y-3">
        <h2 class="text-lg font-semibold">Formations</h2>
        <template x-for="(e, i) in cv.educations" :key="e._id">
          <div class="space-y-2 rounded-lg border border-gray-200 p-3">
            <div class="flex items-center justify-between"><p class="font-semibold" x-text="e.degree || 'Nouvelle formation'"></p>
              <button type="button" class="icon-btn !h-8 !w-8 !bg-transparent text-red-600" @click="cv.educations.splice(i, 1)" aria-label="Supprimer"><%- icon('trash', 'w-4 h-4') %></button></div>
            <input class="input" x-model="e.degree" placeholder="Diplôme ou formation *" maxlength="120">
            <div class="grid grid-cols-2 gap-2"><input class="input" x-model="e.school" placeholder="Établissement" maxlength="120"><input class="input" x-model="e.city" placeholder="Ville" maxlength="80"></div>
            <div class="grid grid-cols-2 gap-2">
              <label class="text-xs text-gray-500">Début<input type="month" class="input mt-0.5" x-model="e.start"></label>
              <label class="text-xs text-gray-500">Fin<input type="month" class="input mt-0.5" x-model="e.end"></label>
            </div>
          </div>
        </template>
        <button type="button" class="btn-soft w-full" @click="addEducation()" x-show="cv.educations.length < 8"><%- icon('plus', 'w-4 h-4') %> Ajouter une formation</button>
      </div>

      <%# 5. Skills %>
      <div x-show="step === 4" class="space-y-3">
        <h2 class="text-lg font-semibold">Compétences</h2>
        <form class="flex gap-2" @submit.prevent="addSkill()">
          <input class="input" x-model="newSkill" maxlength="60" placeholder="Ex. Excel, Permis B, Service client…" aria-label="Nouvelle compétence">
          <button class="btn-primary shrink-0">Ajouter</button>
        </form>
        <ul class="flex flex-wrap gap-2">
          <template x-for="(s, i) in cv.skills" :key="s">
            <li class="flex items-center gap-1 rounded-full bg-brand-50 py-1 pl-3 pr-1 text-sm font-medium text-brand-700"><span x-text="s"></span>
              <button type="button" class="flex h-6 w-6 items-center justify-center rounded-full hover:bg-brand-100" @click="cv.skills.splice(i, 1)" :aria-label="'Retirer ' + s">✕</button></li>
          </template>
        </ul>
      </div>

      <%# 6. Languages %>
      <div x-show="step === 5" class="space-y-3">
        <h2 class="text-lg font-semibold">Langues</h2>
        <template x-for="(l, i) in cv.languages" :key="l._id">
          <div class="flex gap-2">
            <input class="input" x-model="l.name" placeholder="Langue" maxlength="40" aria-label="Langue">
            <select class="input" x-model="l.level" aria-label="Niveau"><template x-for="lv in levels"><option :value="lv" x-text="lv" :selected="lv === l.level"></option></template></select>
            <button type="button" class="icon-btn shrink-0 !bg-transparent text-red-600" @click="cv.languages.splice(i, 1)" aria-label="Supprimer"><%- icon('trash', 'w-4 h-4') %></button>
          </div>
        </template>
        <div class="flex flex-wrap gap-2">
          <template x-for="name in ['Français', 'Wolof', 'Anglais', 'Pulaar', 'Sérère', 'Arabe']">
            <button type="button" class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-medium hover:bg-gray-200" x-show="!cv.languages.some(l => l.name === name)" @click="addLanguage(name)" x-text="'+ ' + name"></button>
          </template>
          <button type="button" class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-medium hover:bg-gray-200" @click="addLanguage('')">+ Autre</button>
        </div>
      </div>

      <%# 7. Template & save %>
      <div x-show="step === 6" class="space-y-3">
        <h2 class="text-lg font-semibold">Choisissez un modèle</h2>
        <div class="grid grid-cols-2 gap-3">
          <% [['classic', 'Classique', 'Sobre, une colonne'], ['modern', 'Moderne', 'Colonne colorée avec photo']].forEach(([key, label, desc]) => { %>
            <button type="button" @click="cv.template = '<%= key %>'" class="rounded-lg border-2 p-3 text-left" :class="cv.template === '<%= key %>' ? 'border-brand-600 bg-brand-50' : 'border-gray-200'">
              <span class="mb-2 flex h-20 overflow-hidden rounded bg-white ring-1 ring-gray-200">
                <% if (key === 'modern') { %><span class="w-1/3 bg-brand-800"></span><% } %>
                <span class="flex-1 space-y-1 p-2"><span class="block h-2 w-2/3 rounded bg-gray-800"></span><span class="block h-1.5 w-1/2 rounded bg-brand-500"></span><span class="block h-1 w-full rounded bg-gray-200"></span><span class="block h-1 w-5/6 rounded bg-gray-200"></span><span class="block h-1 w-full rounded bg-gray-200"></span></span>
              </span>
              <span class="block font-semibold"><%= label %></span><span class="block text-xs text-gray-500"><%= desc %></span>
            </button>
          <% }) %>
        </div>
        <p x-show="error" x-text="error" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
        <button type="button" class="btn-primary w-full !py-3 text-base" :disabled="saving" @click="save()">
          <span x-show="!saving"><%= returnTo ? 'Créer mon CV et revenir à ma candidature' : 'Enregistrer et télécharger le PDF' %></span><span x-show="saving">Création du PDF…</span>
        </button>
        <p class="text-center text-xs text-gray-500"><%= currentUser ? 'Votre CV sera enregistré dans votre profil et utilisé pour vos candidatures.' : 'Créez un compte pour garder votre CV et le réutiliser.' %></p>
      </div>

      <div class="mt-5 flex justify-between gap-2 border-t border-gray-100 pt-3">
        <button type="button" class="btn-light" @click="go(step - 1)" :disabled="step === 0">Précédent</button>
        <button type="button" class="btn-primary" @click="go(step + 1)" x-show="step < 6">Suivant</button>
      </div>
    </section>

    <section :class="tab === 'preview' ? '' : 'hidden lg:block'" aria-label="Aperçu du CV">
      <div class="lg:sticky lg:top-[72px]"><%- include('../../partials/cvPreview') %></div>
    </section>
  </div>
</div>
