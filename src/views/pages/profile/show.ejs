<% const p = profileUser; %>
<div class="space-y-2 sm:space-y-4">
  <section class="card overflow-hidden">
    <div class="relative aspect-[3/1] max-h-56 w-full bg-gradient-to-br from-brand-600 via-brand-500 to-senegal-green">
      <% if (p.coverUrl) { %><img src="<%= p.coverUrl %>" alt="Photo de couverture de <%= p.fullName %>" class="absolute inset-0 h-full w-full object-cover" decoding="async"><% } %>
      <% if (isOwner) { %>
        <form method="post" action="/parametres/couverture?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="absolute bottom-2 right-2">
          <input type="hidden" name="retour" value="/profil/<%= p.username %>">
          <label class="flex cursor-pointer items-center gap-1.5 rounded-md bg-white/90 px-2.5 py-1.5 text-sm font-semibold text-gray-800 shadow hover:bg-white">
            <%- icon('camera', 'w-4 h-4') %><span class="hidden sm:inline"><%= p.coverUrl ? 'Modifier la couverture' : 'Ajouter une couverture' %></span>
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-crop="cover" class="sr-only" aria-label="Choisir une photo de couverture">
          </label>
        </form>
      <% } %>
    </div>
    <div class="px-4 pb-4">
      <div class="relative z-10 -mt-14 flex items-end justify-between gap-3">
        <span class="relative rounded-full bg-white ring-4 ring-white"><%- avatar(p, 'w-28 h-28', 'text-3xl') %>
          <% if (isOwner) { %>
            <form method="post" action="/parametres/photo?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="absolute bottom-0 right-0">
              <input type="hidden" name="retour" value="/profil/<%= p.username %>">
              <label class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-gray-200 text-gray-800 ring-2 ring-white hover:bg-gray-300" title="<%= p.role === 'recruiter' ? 'Changer le logo' : 'Changer la photo de profil' %>">
                <%- icon('camera', 'w-5 h-5') %>
                <input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-crop="avatar" class="sr-only" aria-label="<%= p.role === 'recruiter' ? 'Changer le logo' : 'Changer la photo de profil' %>">
              </label>
            </form>
          <% } %>
        </span>
      </div>
      <h1 class="mt-2 text-2xl font-bold leading-tight">
        <%= p.fullName %>
        <% if (p.isVerified) { %><span class="ml-1"><%- verifiedBadge('w-6 h-6') %></span><% } %>
      </h1>
      <% if (p.headline) { %><p class="mt-0.5 text-[15px] text-gray-700"><%= p.headline %></p><% } %>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
        <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700"><%= roleLabel(p.role) %></span>
        <% if (p.companyName) { %><span class="inline-flex items-center gap-1"><%- icon('building', 'w-4 h-4') %> <%= p.companyName %></span><% } %>
        <% if (p.city) { %><span class="inline-flex items-center gap-1"><%- icon('pin', 'w-4 h-4') %> <%= p.city %></span><% } %>
      </p>
      <p class="mt-2 text-sm">
        <a href="/profil/<%= p.username %>/abonnes" class="hover:underline"><span class="font-semibold" id="followers-count-<%= p.id %>"
          x-data="{ n: <%= p.followersCount %> }" @follow-changed-<%= p.id %>.window="n = $event.detail.followersCount" x-text="n"><%= p.followersCount %></span> <span class="text-gray-500">abonnés</span></a> ·
        <a href="/profil/<%= p.username %>/abonnements" class="hover:underline"><span class="font-semibold"><%= formatCount(p.followingCount) %></span> <span class="text-gray-500">abonnements</span></a>
      </p>

      <div class="mt-4 flex gap-2">
        <% if (isOwner) { %>
          <a href="/parametres/profil" class="btn-primary flex-1 sm:flex-none"><%- icon('pencil', 'w-4 h-4') %> Modifier</a>
          <a href="/cv" class="btn-light flex-1 sm:flex-none"><%- icon('document', 'w-4 h-4') %> Mon CV</a>
        <% } else if (currentUser) { %>
          <%- include('../../partials/followButton', { targetId: p.id, following: followsProfile, variant: 'button' }) %>
          <button type="button" x-data class="btn-light" @click="$dispatch('open-report', { type: 'user', id: <%= p.id %> })" aria-label="Signaler ce profil" title="Signaler ce profil"><%- icon('shield', 'w-4 h-4') %></button>
        <% } else { %>
          <button type="button" data-login="Connectez-vous pour vous abonner et suivre ses publications." class="btn-primary flex-1 sm:flex-none"><%- icon('plus', 'w-4 h-4') %> S'abonner</button>
          <button type="button" data-login="Connectez-vous pour signaler ce profil." class="btn-light" aria-label="Signaler ce profil" title="Signaler ce profil"><%- icon('shield', 'w-4 h-4') %></button>
        <% } %>
      </div>
    </div>
    <% const tabsP = [['publications', 'Publications'], ['a-propos', 'À propos']].concat(p.role !== 'candidate' ? [['offres', 'Offres']] : []); %>
    <nav class="flex border-t border-gray-200 px-2" aria-label="Sections du profil">
      <% tabsP.forEach(([key, label]) => { %>
        <a href="?onglet=<%= key %>" class="relative px-3 py-3 text-[15px] font-semibold <%= tab === key ? 'text-brand-600 after:absolute after:inset-x-2 after:bottom-0 after:h-[3px] after:rounded-t after:bg-brand-600' : 'text-gray-600 hover:bg-gray-100 rounded-md' %>"><%= label %></a>
      <% }) %>
    </nav>
  </section>

  <% if (tab === 'a-propos') { %>
    <section class="card px-4 py-4">
      <h2 class="text-lg font-semibold">À propos</h2>
      <p class="mt-2 whitespace-pre-line text-[15px] text-gray-700"><%= p.bio || (isOwner ? 'Présentez-vous en quelques lignes.' : 'Aucune présentation pour le moment.') %></p>
      <% if (p.sector) { %><p class="mt-3 text-sm text-gray-600"><span class="font-semibold">Secteur :</span> <%= p.sector %></p><% } %>
      <% if (p.skills.length) { %>
        <h3 class="mt-4 font-semibold">Compétences</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          <% p.skills.forEach(s => { %><li class="rounded-full bg-brand-50 px-3 py-1 text-sm font-medium text-brand-700"><%= s %></li><% }) %>
        </ul>
      <% } %>
      <% if (p.experiences.length) { %>
        <h3 class="mt-4 font-semibold">Expériences</h3>
        <ul class="mt-2 space-y-3">
          <% p.experiences.forEach(e => { %>
            <li class="flex gap-3"><span class="mt-0.5 text-gray-400"><%- icon('briefcase', 'w-5 h-5') %></span><div><p class="font-medium"><%= e.title %></p><p class="text-sm text-gray-600"><%= e.company %><%= e.period ? ` · ${e.period}` : '' %></p></div></li>
          <% }) %>
        </ul>
      <% } %>
      <% if (p.educations.length) { %>
        <h3 class="mt-4 font-semibold">Formations</h3>
        <ul class="mt-2 space-y-3">
          <% p.educations.forEach(e => { %>
            <li class="flex gap-3"><span class="mt-0.5 text-gray-400"><%- icon('document', 'w-5 h-5') %></span><div><p class="font-medium"><%= e.degree %></p><p class="text-sm text-gray-600"><%= e.school %><%= e.period ? ` · ${e.period}` : '' %></p></div></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% } else if ((tab === 'publications' || tab === 'offres') && posts.length) { %>
    <% posts.forEach(post => { %><%- include('../../partials/postCard', { post }) %><% }) %>
  <% } else { %>
    <section class="card px-4 py-10 text-center text-gray-500">
      <p><%= tab === 'offres' ? 'Aucune offre publiée pour le moment.' : 'Aucune publication pour le moment.' %></p>
    </section>
  <% } %>
</div>
