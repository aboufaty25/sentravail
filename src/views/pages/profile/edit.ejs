<div class="card rounded-lg px-4 py-5 sm:px-6">
  <div class="mb-4 flex items-center gap-2">
    <a href="/menu" class="icon-btn lg:hidden" aria-label="Retour"><%- icon('arrowLeft', 'w-5 h-5') %></a>
    <h1 class="text-xl font-semibold">Modifier mon profil</h1>
  </div>
  <% const me = currentUser; const isRec = me.role === 'recruiter'; %>
  <section class="mb-5 space-y-3 rounded-lg border border-gray-200 p-3" aria-labelledby="photos-title">
    <h2 id="photos-title" class="font-semibold">Photos</h2>
    <div class="flex items-center gap-3">
      <%- avatar(me, 'w-16 h-16', 'text-xl') %>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium"><%= isRec ? 'Logo de l\'entreprise' : 'Photo de profil' %></p>
        <p class="text-xs text-gray-500"><%= isRec ? 'Affiché sur votre profil et sur vos nouvelles offres.' : 'Une photo nette, de face : les recruteurs vous reconnaissent.' %></p>
        <div class="mt-1.5 flex flex-wrap gap-2">
          <form method="post" action="/parametres/photo?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
            <input type="hidden" name="retour" value="/parametres/profil">
            <label class="btn-light cursor-pointer !py-1.5 text-sm"><%- icon('camera', 'w-4 h-4') %> <%= me.avatarUrl ? 'Changer' : 'Ajouter' %>
              <input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-crop="avatar" class="sr-only"></label>
          </form>
          <% if (me.avatarUrl) { %>
            <form method="post" action="/parametres/photo?_csrf=<%= csrfToken %>" enctype="multipart/form-data" x-data @submit="confirm('Retirer cette photo ?') || $event.preventDefault()">
              <input type="hidden" name="retour" value="/parametres/profil"><input type="hidden" name="action" value="remove">
              <button class="btn !py-1.5 text-sm text-red-600 hover:bg-red-50">Retirer</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
    <div>
      <p class="text-sm font-medium">Photo de couverture</p>
      <div class="mt-1 aspect-[3/1] w-full overflow-hidden rounded-md bg-gradient-to-br from-brand-600 via-brand-500 to-senegal-green">
        <% if (me.coverUrl) { %><img src="<%= me.coverUrl %>" alt="" class="h-full w-full object-cover" loading="lazy"><% } %>
      </div>
      <div class="mt-1.5 flex flex-wrap gap-2">
        <form method="post" action="/parametres/couverture?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
          <input type="hidden" name="retour" value="/parametres/profil">
          <label class="btn-light cursor-pointer !py-1.5 text-sm"><%- icon('camera', 'w-4 h-4') %> <%= me.coverUrl ? 'Changer' : 'Ajouter' %>
            <input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-crop="cover" class="sr-only"></label>
        </form>
        <% if (me.coverUrl) { %>
          <form method="post" action="/parametres/couverture?_csrf=<%= csrfToken %>" enctype="multipart/form-data" x-data @submit="confirm('Retirer la photo de couverture ?') || $event.preventDefault()">
            <input type="hidden" name="retour" value="/parametres/profil"><input type="hidden" name="action" value="remove">
            <button class="btn !py-1.5 text-sm text-red-600 hover:bg-red-50">Retirer</button>
          </form>
        <% } %>
      </div>
      <p class="mt-1 text-xs text-gray-500">Format large conseillé (1500 × 500). L'image est recadrée et allégée automatiquement.</p>
    </div>
  </section>
  <form method="post" action="/parametres/profil" class="space-y-4" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (currentUser.role === 'admin') { %>
      <p class="rounded-lg bg-brand-50 p-3 text-sm text-brand-700">Nom affiché : <strong><%= currentUser.firstName %></strong>. Les comptes administrateurs apparaissent toujours sous ce nom.</p>
    <% } else if (currentUser.role === 'recruiter') { %>
      <%- include('../../partials/field', { name: 'companyName', label: "Nom de l'entreprise *", autocomplete: 'organization', required: true }) %>
      <p class="-mt-2 text-xs text-gray-500">Le nom affiché de votre compte.</p>
    <% } else { %>
    <div class="grid grid-cols-2 gap-3">
      <%- include('../../partials/field', { name: 'firstName', label: 'Prénom', autocomplete: 'given-name', required: true }) %>
      <%- include('../../partials/field', { name: 'lastName', label: 'Nom', autocomplete: 'family-name', required: true }) %>
    </div>
    <% } %>
    <%- include('../../partials/field', { name: 'headline', label: 'Titre professionnel', placeholder: "Ex. Comptable — 5 ans d'expérience" }) %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label for="f-city" class="label">Ville</label>
        <select id="f-city" name="city" class="input">
          <option value="">— Choisir —</option>
          <% CITIES.forEach(c => { %><option <%= values.city === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="f-sector" class="label">Secteur</label>
        <select id="f-sector" name="sector" class="input">
          <option value="">— Choisir —</option>
          <% SECTORS.forEach(s => { %><option <%= values.sector === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
    </div>
    <%- include('../../partials/field', { name: 'phone', type: 'tel', label: 'Téléphone', placeholder: '77 123 45 67', autocomplete: 'tel', inputmode: 'tel' }) %>
    <%- include('../../partials/field', { name: 'skills', label: 'Compétences (séparées par des virgules)', placeholder: 'Excel, Sage, Gestion de stock' }) %>
    <div>
      <label for="f-bio" class="label">À propos</label>
      <textarea id="f-bio" name="bio" rows="5" maxlength="2000" class="input <%= errors.bio ? 'input-error' : '' %>" placeholder="Présentez-vous en quelques lignes"><%= values.bio || '' %></textarea>
      <% if (errors.bio) { %><p class="field-error"><%= errors.bio %></p><% } %>
    </div>
    <% if (currentUser.role === 'candidate') { %>
      <label class="flex items-start gap-3 rounded-lg border border-gray-200 p-3 text-sm">
        <input type="checkbox" name="cvShowcaseRefused" class="mt-0.5 h-5 w-5 shrink-0 rounded border-gray-300 text-brand-600" <%= values.cvShowcaseRefused === true || values.cvShowcaseRefused === 'on' ? 'checked' : '' %>>
        <span><strong>Ne pas afficher mon CV dans la vitrine des CV</strong> — l'équipe SenTravail peut mettre en avant les CV créés ou importés sur le site dans la vitrine visible par tous, pour aider les candidats à être repérés par les recruteurs (<a href="/conditions#vitrine" class="font-semibold text-brand-600 hover:underline">en savoir plus</a>). Cochez cette case pour refuser : votre CV est alors retiré aussitôt.</span>
      </label>
    <% } %>
    <div class="flex justify-end gap-2 pt-2">
      <a href="/profil/<%= currentUser.username %>" class="btn-light">Annuler</a>
      <button type="submit" class="btn-primary">Enregistrer</button>
    </div>
  </form>
</div>
