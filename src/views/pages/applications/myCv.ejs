<div class="space-y-2 sm:space-y-4">
  <h1 class="px-3 text-2xl font-bold sm:px-0">Mon CV</h1>
  <section class="card px-4 py-5">
    <h2 class="font-semibold">CV utilisé pour mes candidatures</h2>
    <p class="mt-1 text-sm text-gray-500">Il est proposé automatiquement quand vous postulez. Seuls les recruteurs à qui vous postulez peuvent le télécharger.</p>
    <% if (currentUser.cvUrl) { %>
      <div class="mt-3 flex items-center gap-3 rounded-lg border border-gray-200 p-3">
        <span class="text-red-600"><%- icon('document', 'w-8 h-8') %></span>
        <a href="<%= cvPath %>" class="min-w-0 flex-1 truncate font-semibold hover:underline"><%= currentUser.cvName || 'CV' %></a>
        <form method="post" action="/cv/retirer" x-data @submit="confirm('Retirer ce CV de votre profil ?') || $event.preventDefault()">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="text-sm font-semibold text-red-600 hover:underline">Retirer</button>
        </form>
      </div>
    <% } %>
    <form method="post" action="/cv/importer?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-center gap-2" x-data="{ name: '' }">
      <label class="btn-light cursor-pointer">
        <%- icon('document', 'w-5 h-5') %> <span x-text="name || '<%= currentUser.cvUrl ? 'Remplacer mon CV' : 'Importer mon CV' %>'"></span>
        <input type="file" name="cv" accept=".pdf,.doc,.docx" class="sr-only" required @change="name = $event.target.files[0]?.name || ''">
      </label>
      <button type="submit" class="btn-primary" x-show="name" x-cloak>Enregistrer</button>
      <span class="w-full text-xs text-gray-500">PDF ou Word, 5 Mo maximum. Un CV importé peut être mis en avant dans la <a href="/conditions#vitrine" class="underline">vitrine des CV</a>, tel quel ; vous pouvez refuser dans <a href="/parametres/profil" class="underline">votre profil</a>.</span>
    </form>
  </section>
  <section class="card px-4 py-5">
    <h2 class="font-semibold">Créateur de CV</h2>
    <p class="mt-1 text-sm text-gray-500">Créez un CV professionnel en quelques minutes : 2 modèles, aperçu en direct, export PDF. Il remplace le CV de votre profil.</p>
    <a href="/cv/creer" class="btn-primary mt-3"><%- icon('pencil', 'w-4 h-4') %> <%= hasBuilt ? 'Modifier mon CV' : 'Créer mon CV' %></a>
  </section>
</div>
