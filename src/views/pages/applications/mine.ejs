<div class="space-y-2 sm:space-y-4">
  <h1 class="px-3 text-2xl font-bold sm:px-0">Mes candidatures</h1>
  <% if (summary.total) { %>
    <ul class="grid grid-cols-4 gap-1.5 px-2 text-center sm:gap-2 sm:px-0" aria-label="Résumé">
      <% [['Envoyées', summary.total, 'text-gray-900'], ['En cours', summary.inProgress, 'text-brand-700'], ['Entretiens', summary.interviews, 'text-purple-700'], ['Embauches', summary.hired, 'text-green-700']].forEach(([label, value, color]) => { %>
        <li class="card rounded-lg px-1 py-2.5"><span class="block text-xl font-bold leading-none <%= color %>"><%= value %></span><span class="mt-1 block text-[11px] text-gray-600 sm:text-xs"><%= label %></span></li>
      <% }) %>
    </ul>
  <% } %>
  <% if (!applications.length) { %>
    <section class="card px-4 py-10 text-center">
      <span class="mx-auto block w-fit text-brand-600"><%- icon('inbox', 'w-12 h-12') %></span>
      <p class="mt-3 font-semibold">Vous n'avez pas encore postulé</p>
      <p class="mt-1 text-sm text-gray-500">Trouvez une offre et appuyez sur « Postuler » : votre candidature sera suivie ici.</p>
      <a href="/offres" class="btn-primary mt-4">Voir les offres</a>
    </section>
  <% } else { %>
    <ul x-data class="card divide-y divide-gray-100">
      <% applications.forEach(a => { %>
        <li class="px-4 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <% if (a.jobPostId && a.jobSlug) { %><a href="/offres/<%= a.jobSlug %>" class="font-semibold hover:underline"><%= a.jobTitle %></a>
              <% } else { %><span class="font-semibold"><%= a.jobTitle %></span> <span class="text-xs text-gray-400">(offre retirée)</span><% } %>
              <p class="text-sm text-gray-600"><%= a.companyName %></p>
              <p class="text-xs text-gray-500">Le <%= formatDate(a.sentAt || a.createdAt) %><%= a.sentVia === 'server' ? ' · envoyée par SenTravail' : a.sentVia === 'platform' ? ' · sur SenTravail' : '' %></p>
            </div>
            <%- include('../../partials/applicationStatus', { app: a, audience: 'candidate' }) %>
          </div>
          <% if (a.status !== 'opened_mail') { %>
            <div class="mt-3"><%- include('../../partials/atsStepper', { app: a, audience: 'candidate' }) %></div>
          <% } %>
          <% if (a.status === 'interview') { %>
            <div class="mt-3 rounded-md border border-purple-200 bg-purple-50 p-3 text-sm text-purple-900">
              <p class="font-semibold"><%- icon('calendar', 'w-4 h-4 inline align-[-3px]') %> Entretien<%= a.interviewAt ? ` le ${formatDateTime(a.interviewAt)}` : '' %></p>
              <% if (a.interviewPlace) { %><p class="mt-0.5 break-words"><%- richText(a.interviewPlace) %></p><% } %>
              <% if (!a.interviewAt) { %><p class="mt-0.5">Le recruteur vous précisera la date et le lieu.</p><% } %>
            </div>
          <% } %>
          <% if (a.status === 'hired') { %>
            <a href="/publier/recrute" class="mt-3 inline-flex items-center gap-1.5 rounded-md bg-green-50 px-3 py-1.5 text-sm font-semibold text-green-800 hover:bg-green-100">🎉 Partager la bonne nouvelle</a>
          <% } %>
          <% if (a.status === 'opened_mail' && a.jobPostId) { %>
            <div class="mt-2 rounded-md bg-amber-50 p-2 text-sm text-amber-800">
              Avez-vous envoyé l'email au recruteur ?
              <button type="button" class="ml-1 font-semibold underline" @click="$dispatch('open-apply', { slug: '<%= a.jobSlug %>', title: <%= JSON.stringify(a.jobTitle) %>, company: <%= JSON.stringify(a.companyName) %>, pendingId: <%= a.id %> })">Terminer ma candidature</button>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
