<!doctype html>
<html lang="fr">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen" hx-headers='{"X-CSRF-Token": "<%= csrfToken %>"}'>
  <main id="main" class="mx-auto w-full <%= wide ? 'max-w-5xl' : 'max-w-md' %> px-4 py-8 sm:py-12">
    <% if (!wide) { %>
      <% if (brand.customLogo) { %>
        <a href="/" class="mb-6 block" aria-label="SenTravail — Accueil"><img src="<%= brand.logo %>" alt="SenTravail" class="mx-auto h-14 w-auto max-w-[260px] object-contain"></a>
      <% } else { %>
        <a href="/" class="mb-6 block text-center text-[40px] font-extrabold tracking-tight text-brand-600" aria-label="SenTravail — Accueil">sentravail</a>
      <% } %>
    <% } %>
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <footer class="pb-8 text-center text-xs text-gray-500 space-x-2">
    <a href="/a-propos" class="hover:underline">À propos</a>
    <a href="/contact" class="hover:underline">Contact</a>
    <a href="/confidentialite" class="hover:underline">Confidentialité</a>
    <a href="/conditions" class="hover:underline">Conditions</a>
    <% if (adsEnabled) { %><a href="/confidentialite#cookies" class="hover:underline">Cookies</a><% } %>
    <span>SenTravail © <%= new Date().getFullYear() %></span>
  </footer>
  <%- script %>
</body>
</html>
