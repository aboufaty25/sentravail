<%# "Continuer avec Google / Apple". Shown only for configured providers.
    roleAware: on the sign-up page, the chosen profile (candidat/recruteur) is passed along. %>
<% if (oauthProviders.length) { %>
  <div class="space-y-2" <%- locals.roleAware ? 'x-data' : '' %>>
    <% if (oauthProviders.includes('google')) { %>
      <a href="/auth/google<%= queryString({ retour: locals.retour || undefined }) %>" <%- locals.roleAware ? `:href="'/auth/google?role=' + role${locals.retour ? ` + '&retour=${encodeURIComponent(retour)}'` : ''}"` : '' %>
        class="flex w-full items-center justify-center gap-3 rounded-md border border-gray-300 bg-white px-4 py-2.5 font-semibold text-gray-800 hover:bg-gray-50">
        <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        <%= verb %> avec Google
      </a>
    <% } %>
    <% if (oauthProviders.includes('apple')) { %>
      <a href="/auth/apple<%= queryString({ retour: locals.retour || undefined }) %>" <%- locals.roleAware ? `:href="'/auth/apple?role=' + role${locals.retour ? ` + '&retour=${encodeURIComponent(retour)}'` : ''}"` : '' %>
        class="flex w-full items-center justify-center gap-3 rounded-md bg-black px-4 py-2.5 font-semibold text-white hover:bg-gray-800">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.18-1.73-1.35-.14-2.64.8-3.33.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.59 2.17-1.53 2.65-.39 6.58 1.1 8.73.73 1.05 1.6 2.23 2.73 2.19 1.1-.04 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.07 2.65-2.13.84-1.22 1.18-2.4 1.2-2.46-.03-.01-2.29-.88-2.3-3.48zM14.2 6.13c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.31-.56.65-1.05 1.68-.92 2.68.97.07 1.96-.49 2.56-1.23z"/></svg>
        <%= verb %> avec Apple
      </a>
    <% } %>
    <div class="flex items-center gap-3 py-1 text-xs text-gray-400"><span class="h-px flex-1 bg-gray-200"></span>ou<span class="h-px flex-1 bg-gray-200"></span></div>
  </div>
<% } %>
