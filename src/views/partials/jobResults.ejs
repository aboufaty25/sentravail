<% posts.forEach((post) => { %><%- include('postCard', { post }) %><% }) %>
<% if (hasMore) { %>
  <div hx-get="/offres<%= queryString({ q: filters.q, ville: filters.ville, secteur: filters.secteur, contrat: filters.contrat, page: page + 1 }) %>"
    hx-trigger="revealed" hx-swap="outerHTML" class="py-6 text-center">
    <span class="inline-block h-6 w-6 animate-spin rounded-full border-2 border-gray-300 border-t-brand-600" aria-hidden="true"></span><span class="sr-only">Chargement…</span>
  </div>
<% } %>
