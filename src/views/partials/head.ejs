<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title === 'SenTravail' ? title : `${title} | SenTravail` %></title>
<meta name="description" content="<%= metaDescription %>">
<meta name="theme-color" content="#1668e3">
<% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:site_name" content="SenTravail">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="<%= locals.ogType || 'website' %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="<%= locals.canonical || `${appUrl}${currentPath}` %>">
<meta property="og:image" content="<%= ogImage %>">
<% if (ogImage.startsWith('https://')) { %><meta property="og:image:secure_url" content="<%= ogImage %>"><% } %>
<meta property="og:image:alt" content="<%= locals.ogImageAlt || title %>">
<meta name="twitter:card" content="<%= ogImage.endsWith('og-default.jpg') || locals.ogLargeImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">
<% if (locals.jsonLd) { %><script type="application/ld+json"><%- jsonLd %></script><% } %>
<link rel="icon" href="/icons/logo.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="SenTravail">
<link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
<meta name="csrf-token" content="<%= csrfToken %>">
<script src="/vendor/htmx/htmx.min.js?v=<%= assetVersion %>" defer></script>
<% if (locals.currentUser) { %><script src="/socket.io/socket.io.min.js" defer></script><% } %>
<%# app.js must run before Alpine so its components are registered on alpine:init %>
<script src="/js/app.js?v=<%= assetVersion %>" defer></script>
<script src="/vendor/alpine/cdn.min.js?v=<%= assetVersion %>" defer></script>
<%# AdSense loads only after consent (public/js/ads.js), never on ad-free pages %>
<% if (adsEnabled && !noAds) { %><script src="/js/ads.js?v=<%= assetVersion %>" data-client="<%= adsClient %>" defer></script><% } %>
