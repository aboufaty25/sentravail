<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title === 'SenTravail' ? title : `${title} | SenTravail` %></title>
<meta name="description" content="<%= metaDescription %>">
<meta name="theme-color" content="#1668e3">
<% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:site_name" content="SenTravail">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="<%= locals.ogType || 'website' %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= metaDescription %>">
<meta property="og:url" content="<%= locals.canonical || `${appUrl}${currentPath}` %>">
<meta property="og:image" content="<%= ogImage %>">
<% if (ogImage.startsWith('https://')) { %><meta property="og:image:secure_url" content="<%= ogImage %>"><% } %>
<meta property="og:image:alt" content="<%= locals.ogImageAlt || title %>">
<meta name="twitter:card" content="<%= ogImage === brand.shareImage || locals.ogLargeImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= metaDescription %>">
<meta name="twitter:image" content="<%= ogImage %>">
<% if (google.siteVerification && currentPath === '/') { %><meta name="google-site-verification" content="<%= google.siteVerification %>"><% } %>
<%# Google Analytics 4: not on admin pages (the team's own visits would skew the figures). %>
<% if (google.analyticsId && !/^\/admin/.test(currentPath)) { %>
<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
<script src="/js/analytics.js?v=<%= assetVersion %>" data-id="<%= google.analyticsId %>" data-events="<%= JSON.stringify(gaEvents) %>"<% if (currentUser) { %> data-user="<%= currentUser.role %>"<% } %> async></script>
<% } %>
<% if (locals.jsonLd) { %><script type="application/ld+json"><%- jsonLd %></script><% } %>
<link rel="icon" href="<%= brand.favicon %>" type="<%= brand.faviconType %>">
<link rel="apple-touch-icon" href="<%= brand.appleIcon %>">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="SenTravail">
<link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
<meta name="csrf-token" content="<%= csrfToken %>">
<script src="/vendor/htmx/htmx.min.js?v=<%= assetVersion %>" defer></script>
<% if (locals.currentUser) { %><script src="/socket.io/socket.io.min.js" defer></script><% } %>
<%# app.js must run before Alpine so its components are registered on alpine:init %>
<script src="/js/app.js?v=<%= assetVersion %>" defer></script>
<script src="/vendor/alpine/cdn.min.js?v=<%= assetVersion %>" defer></script>
<%# AdSense (public/js/ads.js), never on ad-free pages. Early connections make ads appear sooner. %>
<% if (adsEnabled && !noAds) { %>
<link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>
<link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin>
<link rel="preconnect" href="https://tpc.googlesyndication.com" crossorigin>
<link rel="dns-prefetch" href="https://ep1.adtrafficquality.google">
<script src="/js/ads.js?v=<%= assetVersion %>" data-client="<%= adsClient %>" async></script>
<% } %>
