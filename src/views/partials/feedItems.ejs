<%# Ads: after the 1st job offer, then after every 3 more offers (offers 1, 4, 7, 10…). The count
    carries over the infinite-scroll pages (?offers=). %>
<% let offers = locals.offersBefore || 0; %>
<% posts.forEach((post) => { %>
  <%- include('postCard', { post }) %>
  <% if (post.type === 'job') { offers += 1; if (offers % 3 === 1) { %><%- include('adSlot', { slot: 'feed' }) %><% } } %>
<% }) %>
<% if (hasMore) { %>
  <div hx-get="/fil?page=<%= page + 1 %>&since=<%= since %>&offers=<%= offers %>" hx-trigger="revealed" hx-swap="outerHTML" class="py-6 text-center text-sm text-gray-500">
    <span class="inline-block h-6 w-6 animate-spin rounded-full border-2 border-gray-300 border-t-brand-600" aria-hidden="true"></span>
    <span class="sr-only">Chargement…</span>
  </div>
<% } else if (page > 1 || posts.length) { %>
  <p class="py-6 text-center text-sm text-gray-500">Vous êtes à jour 🎉</p>
<% } %>
