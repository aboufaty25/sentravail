<section class="card p-4" aria-labelledby="featured-title">
  <div class="flex items-center justify-between">
    <h2 id="featured-title" class="font-semibold text-gray-700">Offres à la une</h2>
    <a href="/offres" class="text-sm font-medium text-brand-600 hover:underline">Tout voir</a>
  </div>
  <div hx-get="/offres-a-la-une" hx-trigger="intersect once" hx-swap="innerHTML" class="mt-2">
    <p class="text-sm text-gray-400">Chargement…</p>
  </div>
</section>
<section class="card mt-3 p-4" aria-labelledby="suggest-title">
  <div class="flex items-center justify-between">
    <h2 id="suggest-title" class="font-semibold text-gray-700">Suggestions d'abonnements</h2>
    <a href="/reseau" <%- loginAttr(currentUser, 'Connectez-vous pour suivre des recruteurs et des candidats.') %> class="text-sm font-medium text-brand-600 hover:underline">Voir plus</a>
  </div>
  <div hx-get="/reseau/suggestions" hx-trigger="intersect once" hx-swap="innerHTML" class="mt-3"><p class="text-sm text-gray-400">Chargement…</p></div>
</section>
<% if (!noAds) { %><div class="mt-3"><%- include('adSlot', { slot: 'sidebar' }) %></div><% } %>
<footer class="mt-4 px-2 text-xs leading-6 text-gray-500">
  <a href="/a-propos" class="hover:underline">À propos</a> ·
  <a href="/contact" class="hover:underline">Contact</a> ·
  <a href="/confidentialite" class="hover:underline">Confidentialité</a> ·
  <a href="/conditions" class="hover:underline">Conditions</a>
  <% if (adsEnabled) { %> · <a href="/confidentialite#cookies" data-consent-reset class="hover:underline">Cookies</a><% } %>
  <p>SenTravail © <%= new Date().getFullYear() %></p>
</footer>
