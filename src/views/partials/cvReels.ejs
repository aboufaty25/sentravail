<%# CV slider ("Vitrine des CV"), shaped like Facebook's Reels tray: tall 9:16 cards scrolled
    sideways (swipe on a phone, round arrows on a computer). Static CV images, never video.
    items: services/cvShowcase.slider(). Each card opens the full-screen viewer /cv/vitrine.
    The first card has two buttons: "Créer un CV" and "Importer un CV" (direct upload). %>
<% const reels = locals.items || []; %>
<% if (reels.length) { %>
<section class="card py-3 sm:rounded-lg" aria-label="Vitrine des CV" data-reels>
  <div class="flex items-center justify-between px-4 pb-2.5">
    <h2 class="flex items-center gap-2 text-[17px] font-semibold">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-brand-600 to-senegal-green text-white"><%- icon('document', 'w-4 h-4') %></span>
      Vitrine des CV
    </h2>
    <a href="/cv/vitrine" class="rounded-md px-2 py-1 text-sm font-semibold text-brand-600 hover:bg-gray-100">Voir tout</a>
  </div>
  <div class="relative">
    <div class="flex snap-x snap-mandatory gap-2 overflow-x-auto scroll-smooth px-4 scroll-px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-reels-track>
      <%# First card, split in two like Facebook's create card: "Créer un CV" / "Importer un CV". %>
      <div class="flex aspect-[9/16] w-[118px] shrink-0 snap-start flex-col overflow-hidden rounded-xl border border-gray-200 bg-white sm:w-[140px]">
        <a href="/cv/creer" <%- loginAttr(currentUser, 'Connectez-vous pour créer votre CV.') %> class="group flex flex-1 flex-col items-center justify-center gap-2 bg-gradient-to-b from-brand-50 to-white px-2 text-center hover:from-brand-100">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-white shadow-sm transition group-hover:scale-105"><%- icon('plus', 'w-5 h-5') %></span>
          <span class="text-[13px] font-semibold leading-tight text-gray-900">Créer un CV</span>
        </a>
        <div class="h-px bg-gray-200"></div>
        <% if (currentUser) { %>
          <form method="post" action="/cv/importer?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="flex flex-1" x-data="{ busy: false }">
            <input type="hidden" name="retour" value="<%= currentPath %>">
            <label class="group flex flex-1 cursor-pointer flex-col items-center justify-center gap-2 px-2 text-center hover:bg-gray-50">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-senegal-green text-white shadow-sm transition group-hover:scale-105"><%- icon('document', 'w-5 h-5') %></span>
              <span class="text-[13px] font-semibold leading-tight text-gray-900" x-text="busy ? 'Import…' : 'Importer un CV'">Importer un CV</span>
              <input type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf" class="sr-only" @change="if ($event.target.files.length) { busy = true; $el.form.submit(); }">
            </label>
          </form>
        <% } else { %>
          <button type="button" <%- loginAttr(null, 'Connectez-vous pour importer votre CV.') %> class="group flex flex-1 flex-col items-center justify-center gap-2 px-2 text-center hover:bg-gray-50">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-senegal-green text-white shadow-sm transition group-hover:scale-105"><%- icon('document', 'w-5 h-5') %></span>
            <span class="text-[13px] font-semibold leading-tight text-gray-900">Importer un CV</span>
          </button>
        <% } %>
      </div>
      <% reels.forEach((r) => { const thumb = r.source === 'built' || r.masked ? r.thumbnail : null; %>
        <% const tint = /^#[0-9a-fA-F]{6}$/.test(r.color || '') ? r.color : '#1668e3'; %>
        <%# Light "paper" card: the CV page sits like a sheet on a soft tint, the caption is on white below.
            Nothing is laid over the CV. %>
        <a href="/cv/vitrine?id=<%= r.id %>" class="group flex aspect-[9/16] w-[118px] shrink-0 snap-start flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:w-[140px]" aria-label="CV de <%= r.name %><%= r.title ? `, ${r.title}` : '' %>">
          <span class="relative block min-h-0 flex-1 overflow-hidden px-2 pt-2" style="background: linear-gradient(180deg, <%= tint %>26, <%= tint %>0d)">
            <% if (thumb) { %>
              <img src="<%= thumb %>" alt="" loading="lazy" decoding="async" class="block w-full rounded-[3px] bg-white shadow-[0_2px_8px_rgba(15,23,42,0.18)] ring-1 ring-black/5 transition duration-300 group-hover:scale-[1.03]">
            <% } else { %>
              <%# No image yet: a sketch of a CV page in the template colour. %>
              <span class="block aspect-[1/1.414] w-full overflow-hidden rounded-[3px] bg-white shadow-[0_2px_8px_rgba(15,23,42,0.18)] ring-1 ring-black/5" aria-hidden="true">
                <span class="block h-[22%]" style="background: <%= tint %>"></span>
                <span class="block space-y-1.5 p-2">
                  <span class="block h-1.5 w-3/4 rounded bg-gray-300"></span><span class="block h-1.5 w-1/2 rounded bg-gray-200"></span>
                  <span class="block h-1.5 w-5/6 rounded bg-gray-200"></span><span class="block h-1.5 w-2/3 rounded bg-gray-200"></span>
                  <span class="block h-1.5 w-3/4 rounded bg-gray-200"></span>
                </span>
              </span>
            <% } %>
            <span class="absolute inset-x-0 bottom-0 h-4 bg-gradient-to-t from-white/90 to-transparent" aria-hidden="true"></span>
          </span>
          <span class="block shrink-0 px-2 pb-2 pt-1.5">
            <%# The member's photo sits in the caption, never over the CV. %>
            <span class="flex items-center gap-1.5">
              <% if (r.user && r.user.avatarUrl) { %><img src="<%= r.user.avatarUrl %>" alt="" loading="lazy" class="h-6 w-6 shrink-0 rounded-full object-cover ring-2" style="--tw-ring-color: <%= tint %>"><% } %>
              <span class="min-w-0">
                <span class="block truncate text-[13px] font-semibold leading-tight text-gray-900"><%= r.name %></span>
                <% if (r.title) { %><span class="block truncate text-[11px] leading-tight text-gray-500"><%= r.title %></span><% } %>
              </span>
            </span>
            <span class="mt-1 flex items-center gap-1 text-[11px] font-medium text-gray-500"><%- icon('eye', 'w-3.5 h-3.5') %> <%= formatCount(r.viewsCount) %> vue<%= r.viewsCount > 1 ? 's' : '' %></span>
          </span>
        </a>
      <% }) %>
    </div>
    <%# Computer: round arrows over the edges, like Facebook. %>
    <button type="button" class="invisible absolute left-2 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-gray-700 shadow-md ring-1 ring-black/5 hover:bg-gray-50 sm:flex" data-reels-prev aria-label="CV précédents"><span class="rotate-180"><%- icon('chevronRight', 'w-5 h-5') %></span></button>
    <button type="button" class="absolute right-2 top-1/2 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-gray-700 shadow-md ring-1 ring-black/5 hover:bg-gray-50 sm:flex" data-reels-next aria-label="CV suivants"><%- icon('chevronRight', 'w-5 h-5') %></button>
  </div>

</section>
<% } %>
