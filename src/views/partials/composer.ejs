<%# "Quoi de neuf ?" opens the choice of publication type (no free-form posts). %>
<section class="card px-3 py-3 sm:px-4" aria-label="Publier" x-data="{ open: false }" @keydown.escape.window="open = false">
  <div class="flex items-center gap-2">
    <a href="/profil/<%= currentUser.username %>" class="shrink-0"><%- avatar(currentUser, 'w-10 h-10') %></a>
    <button type="button" @click="open = true" class="flex-1 rounded-full border border-gray-300 px-4 py-2.5 text-left text-[15px] text-gray-500 hover:bg-gray-100">Quoi de neuf dans votre recherche d'emploi ?</button>
  </div>
  <div class="mt-3 grid grid-cols-3 border-t border-gray-200 pt-2 text-[13px] font-semibold text-gray-600">
    <% const quick = currentUser.hasRole('recruiter', 'admin') ? [['/offres/nouvelle', 'briefcase', 'text-brand-600', 'Offre'], ['/publier/evenement', 'calendar', 'text-orange-600', 'Événement'], ['/publier/recrute', 'star', 'text-amber-600', 'Recruté !']] : [['/publier/recherche-emploi', 'search', 'text-emerald-600', 'Je cherche'], ['/publier/evenement', 'calendar', 'text-orange-600', 'Événement'], ['/publier/recrute', 'star', 'text-amber-600', 'Recruté !']]; %>
    <% quick.forEach(([href, ic, color, label]) => { %>
      <a href="<%= href %>" class="flex items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100"><span class="<%= color %>"><%- icon(ic, 'w-5 h-5') %></span> <%= label %></a>
    <% }) %>
  </div>

  <div x-cloak x-show="open" x-transition.opacity class="fixed inset-0 z-50 bg-black/50" @click="open = false"></div>
  <div x-cloak x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="translate-y-full sm:translate-y-4 sm:opacity-0" x-transition:enter-end="translate-y-0 sm:opacity-100"
    class="fixed inset-x-0 bottom-0 z-50 max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 pb-[calc(1rem+env(safe-area-inset-bottom))] shadow-2xl sm:inset-x-auto sm:left-1/2 sm:top-1/2 sm:bottom-auto sm:w-[480px] sm:-translate-x-1/2 sm:-translate-y-1/2 sm:rounded-xl"
    role="dialog" aria-modal="true" aria-labelledby="publish-title">
    <div class="mb-3 flex items-center justify-between">
      <h2 id="publish-title" class="text-lg font-semibold">Que voulez-vous publier ?</h2>
      <button type="button" class="icon-btn" @click="open = false" aria-label="Fermer"><%- icon('x', 'w-5 h-5') %></button>
    </div>
    <%- include('publishOptions', { options: publishOptions(currentUser) }) %>
  </div>
</section>
