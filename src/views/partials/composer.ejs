<section class="card px-3 py-3 sm:px-4" aria-label="Publier">
  <div class="flex items-center gap-2">
    <a href="/profil/<%= currentUser.username %>" class="shrink-0"><%- avatar(currentUser, 'w-10 h-10') %></a>
    <a href="/publier" class="flex-1 rounded-full border border-gray-300 px-4 py-2.5 text-[15px] text-gray-500 hover:bg-gray-100">Partagez une actualité ou une offre…</a>
  </div>
  <div class="mt-3 flex border-t border-gray-200 pt-2 text-sm font-semibold text-gray-600">
    <a href="/publier?type=photo" class="flex flex-1 items-center justify-center gap-2 rounded-md py-2 hover:bg-gray-100"><span class="text-green-600"><%- icon('photo') %></span> Photo</a>
    <a href="/reels/nouveau" class="flex flex-1 items-center justify-center gap-2 rounded-md py-2 hover:bg-gray-100"><span class="text-rose-600"><%- icon('video') %></span> Réel</a>
    <% if (currentUser.hasRole('recruiter', 'admin')) { %>
      <a href="/publier?type=job" class="flex flex-1 items-center justify-center gap-2 rounded-md py-2 hover:bg-gray-100"><span class="text-brand-600"><%- icon('briefcase') %></span> Offre</a>
    <% } %>
  </div>
</section>
