<% if (flash && flash.length) { %>
  <div class="space-y-2 mb-3 px-3 sm:px-0" role="status">
    <% flash.forEach(f => { %>
      <div x-data="{ show: true }" x-show="show" class="flex items-start gap-2 rounded-lg px-4 py-3 text-sm <%= f.type === 'error' ? 'bg-red-50 text-red-800' : f.type === 'success' ? 'bg-green-50 text-green-800' : 'bg-brand-50 text-brand-800' %>">
        <span class="flex-1"><%= f.message %></span>
        <button type="button" @click="show = false" class="opacity-60 hover:opacity-100" aria-label="Fermer">✕</button>
      </div>
    <% }) %>
  </div>
<% } %>
