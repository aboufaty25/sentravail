<%# Live HTML preview of the CV (mirrors services/cvPdf.js). All values bound with x-text (escaped). %>
<div class="mx-auto aspect-[210/297] w-full max-w-[560px] overflow-hidden bg-white text-[10px] leading-snug text-gray-900 shadow-lg ring-1 ring-black/5">
  <%# Classic %>
  <div x-show="cv.template === 'classic'" class="h-full overflow-hidden p-[6%]">
    <div class="flex items-center gap-3">
      <template x-if="cv.personal.photoUrl"><img :src="cv.personal.photoUrl" alt="" class="h-14 w-14 shrink-0 rounded-full object-cover"></template>
      <div class="min-w-0">
        <p class="text-[18px] font-bold leading-tight" x-text="fullName() || 'Prénom Nom'"></p>
        <p class="text-[11px] text-brand-600" x-text="cv.title || 'Titre professionnel'"></p>
        <p class="mt-0.5 text-[8.5px] text-gray-500" x-text="[cv.personal.email, cv.personal.phone, cv.personal.city].filter(Boolean).join('  •  ')"></p>
      </div>
    </div>
    <template x-if="cv.summary"><div><p class="mt-3 border-b border-gray-300 pb-0.5 text-[9.5px] font-bold uppercase tracking-wider text-brand-600">Profil</p><p class="mt-1 whitespace-pre-line" x-text="cv.summary"></p></div></template>
    <template x-if="cv.experiences.length"><div>
      <p class="mt-3 border-b border-gray-300 pb-0.5 text-[9.5px] font-bold uppercase tracking-wider text-brand-600">Expériences professionnelles</p>
      <template x-for="(e, i) in cv.experiences" :key="i"><div class="mt-1.5">
        <p><span class="font-bold" x-text="e.title || 'Poste'"></span><span class="text-gray-500" x-show="e.company" x-text="'  —  ' + e.company + (e.city ? ', ' + e.city : '')"></span></p>
        <p class="text-[8.5px] text-brand-600" x-text="period(e)"></p>
        <p class="whitespace-pre-line text-[9px]" x-text="e.description"></p>
      </div></template>
    </div></template>
    <template x-if="cv.educations.length"><div>
      <p class="mt-3 border-b border-gray-300 pb-0.5 text-[9.5px] font-bold uppercase tracking-wider text-brand-600">Formation</p>
      <template x-for="(e, i) in cv.educations" :key="i"><div class="mt-1.5">
        <p class="font-bold" x-text="e.degree || 'Diplôme'"></p>
        <p class="text-[8.5px] text-gray-500" x-text="[[e.school, e.city].filter(Boolean).join(', '), period(e)].filter(Boolean).join('  •  ')"></p>
      </div></template>
    </div></template>
    <template x-if="cv.skills.length"><div><p class="mt-3 border-b border-gray-300 pb-0.5 text-[9.5px] font-bold uppercase tracking-wider text-brand-600">Compétences</p><p class="mt-1" x-text="cv.skills.join('  •  ')"></p></div></template>
    <template x-if="cv.languages.length"><div><p class="mt-3 border-b border-gray-300 pb-0.5 text-[9.5px] font-bold uppercase tracking-wider text-brand-600">Langues</p><p class="mt-1" x-text="cv.languages.map(l => l.name + ' (' + l.level.toLowerCase() + ')').join('  •  ')"></p></div></template>
  </div>

  <%# Modern %>
  <div x-show="cv.template === 'modern'" class="flex h-full">
    <div class="w-[31%] shrink-0 bg-brand-800 p-[4%] text-[8.5px] text-blue-50">
      <template x-if="cv.personal.photoUrl"><img :src="cv.personal.photoUrl" alt="" class="mx-auto mb-3 h-20 w-20 rounded-full object-cover"></template>
      <p class="border-b border-blue-300/60 pb-0.5 text-[9px] font-bold uppercase tracking-wider text-white">Contact</p>
      <template x-for="t in [cv.personal.email, cv.personal.phone, cv.personal.city].filter(Boolean)"><p class="mt-1 break-words" x-text="t"></p></template>
      <template x-if="cv.skills.length"><div><p class="mt-3 border-b border-blue-300/60 pb-0.5 text-[9px] font-bold uppercase tracking-wider text-white">Compétences</p><template x-for="s in cv.skills"><p class="mt-0.5" x-text="'• ' + s"></p></template></div></template>
      <template x-if="cv.languages.length"><div><p class="mt-3 border-b border-blue-300/60 pb-0.5 text-[9px] font-bold uppercase tracking-wider text-white">Langues</p><template x-for="l in cv.languages"><div class="mt-1"><p class="font-bold" x-text="l.name"></p><p x-text="l.level"></p></div></template></div></template>
    </div>
    <div class="min-w-0 flex-1 overflow-hidden p-[5%]">
      <p class="text-[18px] font-bold leading-tight" x-text="fullName() || 'Prénom Nom'"></p>
      <p class="text-[11px] text-brand-600" x-text="cv.title || 'Titre professionnel'"></p>
      <template x-if="cv.summary"><div><p class="mt-3 text-[10.5px] font-bold text-brand-800">Profil</p><p class="mt-0.5 whitespace-pre-line" x-text="cv.summary"></p></div></template>
      <template x-if="cv.experiences.length"><div>
        <p class="mt-3 text-[10.5px] font-bold text-brand-800">Expériences</p>
        <template x-for="(e, i) in cv.experiences" :key="i"><div class="mt-1.5">
          <p class="font-bold" x-text="e.title || 'Poste'"></p>
          <p class="text-[8.5px] text-gray-500" x-text="[[e.company, e.city].filter(Boolean).join(', '), period(e)].filter(Boolean).join('  •  ')"></p>
          <p class="whitespace-pre-line text-[9px]" x-text="e.description"></p>
        </div></template>
      </div></template>
      <template x-if="cv.educations.length"><div>
        <p class="mt-3 text-[10.5px] font-bold text-brand-800">Formation</p>
        <template x-for="(e, i) in cv.educations" :key="i"><div class="mt-1.5">
          <p class="font-bold" x-text="e.degree || 'Diplôme'"></p>
          <p class="text-[8.5px] text-gray-500" x-text="[[e.school, e.city].filter(Boolean).join(', '), period(e)].filter(Boolean).join('  •  ')"></p>
        </div></template>
      </div></template>
    </div>
  </div>
</div>
