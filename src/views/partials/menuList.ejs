<% const u = currentUser; const L = (msg) => loginAttr(u, msg); %>
<% if (u) { %>
<a href="/profil/<%= u.username %>" class="menu-item">
  <%- avatar(u, 'w-9 h-9') %>
  <span class="min-w-0"><span class="block truncate font-semibold"><%= u.fullName %></span><span class="block text-xs text-gray-500">Voir mon profil</span></span>
</a>
<% } else { %>
<a href="/connexion<%= currentPath !== '/menu' && currentPath !== '/' ? queryString({ retour: currentPath }) : '' %>" class="menu-item">
  <%- guestAvatar('w-9 h-9') %>
  <span class="min-w-0"><span class="block truncate font-semibold">Se connecter</span><span class="block text-xs text-gray-500">ou créer un compte gratuit</span></span>
</a>
<% } %>
<hr class="my-1 border-gray-200">
<a href="/cv" <%- L('Connectez-vous pour créer et gérer votre CV.') %> class="menu-item"><span class="text-brand-600"><%- icon('document') %></span> Mon CV</a>
<a href="/mes-candidatures" <%- L('Connectez-vous pour suivre vos candidatures.') %> class="menu-item"><span class="text-brand-600"><%- icon('inbox') %></span> Mes candidatures</a>
<a href="/enregistrements" <%- L('Connectez-vous pour retrouver les offres enregistrées.') %> class="menu-item"><span class="text-brand-600"><%- icon('bookmark') %></span> Offres enregistrées</a>
<% if (u && u.hasRole('recruiter', 'admin')) { %>
  <a href="/mes-offres" class="menu-item"><span class="text-brand-600"><%- icon('briefcase') %></span> Tableau de recrutement</a>
<% } %>
<% if (u && u.role === 'recruiter') { %>
  <a href="/parametres/verification" class="menu-item"><span class="text-brand-600"><%- icon('check') %></span> Badge vérifié <% if (u.isVerified) { %><%- verifiedBadge('w-4 h-4') %><% } %></a>
<% } %>
<% if (u && u.hasRole('admin')) { %>
  <a href="/admin" class="menu-item"><span class="text-brand-600"><%- icon('shield') %></span> Administration</a>
<% } %>
<a href="/parametres/profil" <%- L('Connectez-vous pour modifier votre profil.') %> class="menu-item"><span class="text-gray-600"><%- icon('cog') %></span> Paramètres du profil</a>
<a href="/parametres/notifications" <%- L('Connectez-vous pour gérer vos notifications.') %> class="menu-item"><span class="text-gray-600"><%- icon('bell') %></span> Notifications par email</a>
<% if (u) { %>
<form action="/deconnexion" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" class="menu-item w-full text-left"><span class="text-gray-600"><%- icon('logout') %></span> Déconnexion</button>
</form>
<% } %>
