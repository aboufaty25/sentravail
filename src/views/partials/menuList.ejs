<% const u = currentUser; %>
<a href="/profil/<%= u.username %>" class="menu-item">
  <%- avatar(u, 'w-9 h-9') %>
  <span class="min-w-0"><span class="block truncate font-semibold"><%= u.fullName %></span><span class="block text-xs text-gray-500">Voir mon profil</span></span>
</a>
<hr class="my-1 border-gray-200">
<a href="/cv" class="menu-item"><span class="text-brand-600"><%- icon('document') %></span> Mon CV</a>
<a href="/mes-candidatures" class="menu-item"><span class="text-brand-600"><%- icon('inbox') %></span> Mes candidatures</a>
<a href="/enregistrements" class="menu-item"><span class="text-brand-600"><%- icon('bookmark') %></span> Offres enregistrées</a>
<% if (u.hasRole('recruiter', 'admin')) { %>
  <a href="/mes-offres" class="menu-item"><span class="text-brand-600"><%- icon('briefcase') %></span> Mes offres et candidatures reçues</a>
<% } %>
<% if (u.role === 'recruiter') { %>
  <a href="/parametres/verification" class="menu-item"><span class="text-brand-600"><%- icon('check') %></span> Badge vérifié <%= u.isVerified ? '✓' : '' %></a>
<% } %>
<% if (u.hasRole('admin')) { %>
  <a href="/admin" class="menu-item"><span class="text-brand-600"><%- icon('shield') %></span> Administration</a>
<% } %>
<a href="/parametres/profil" class="menu-item"><span class="text-gray-600"><%- icon('cog') %></span> Paramètres du profil</a>
<a href="/parametres/notifications" class="menu-item"><span class="text-gray-600"><%- icon('bell') %></span> Notifications par email</a>
<form action="/deconnexion" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" class="menu-item w-full text-left"><span class="text-gray-600"><%- icon('logout') %></span> Déconnexion</button>
</form>
