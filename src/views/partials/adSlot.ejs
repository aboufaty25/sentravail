<%# AdSense unit. Rendered only when ads are on, the page allows ads and a slot id exists.
    The <ins> tag is created by public/js/ads.js when the unit is requested (adsbygoogle.push
    fills the first empty <ins> of the page); the frame stays folded until Google has filled it.
    Requested as soon as the page loads, except lazy units (feed ads after the first one),
    requested about two screens before they scroll into view.
    slot: feed | sidebar | jobTop | jobBottom. inline: no card frame (inside another card). %>
<% const place = locals.slot || 'feed'; const slotId = adSlots[place]; %>
<% if (adsEnabled && !noAds && slotId) { %>
  <div data-ad-slot-wrapper data-ad-place="<%= place %>"<%= locals.lazy ? ' data-ad-lazy' : '' %> data-ad-client="<%= adsClient %>" data-ad-slot="<%= slotId %>" data-ad-format="<%= place === 'sidebar' ? 'rectangle' : 'auto' %>"
    class="ad-unit <%= locals.inline ? 'my-3' : 'card overflow-hidden px-3 py-2 sm:rounded-lg' %>" aria-label="Publicité">
    <p class="mb-1 text-[11px] uppercase tracking-wide text-gray-400">Publicité</p>
  </div>
<% } %>
