<% if (!suggestions.length) { %><p class="text-sm text-gray-500">Aucune suggestion pour le moment.</p><% } %>
<ul class="space-y-3">
  <% suggestions.forEach(u => { %>
    <li class="flex items-center gap-2.5">
      <a href="/profil/<%= u.username %>"><%- avatar(u, 'w-10 h-10') %></a>
      <div class="min-w-0 flex-1">
        <a href="/profil/<%= u.username %>" class="block truncate text-sm font-semibold hover:underline"><%= u.firstName %> <%= u.lastName %><% if (u.isVerified) { %> <%- verifiedBadge('w-3.5 h-3.5') %><% } %></a>
        <p class="truncate text-xs text-gray-500"><%= u.reason %></p>
      </div>
      <% if (currentUser) { %><%- include('followButton', { targetId: u.id, following: false, variant: 'link' }) %>
      <% } else { %><button type="button" class="text-[13px] font-semibold text-brand-600 hover:underline" data-login="Connectez-vous pour vous abonner et suivre ses publications.">· S'abonner</button><% } %>
    </li>
  <% }) %>
</ul>
