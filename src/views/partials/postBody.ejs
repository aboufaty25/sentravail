<%# Text (and image) of a share comment or a legacy free post. Typed publications use cards/*. %>
<% if (p.text) { %><%- include('postText', { text: p.text, cls: 'px-3 sm:px-4 pb-2' }) %><% } %>
<% const imgs = p.mediaUrls || []; if (imgs.length) { %>
  <a href="/publications/<%= p.id %>" class="block bg-gray-100" aria-label="Voir la publication">
    <img src="<%= imageUrl(imgs[0], 900) %>" alt="" loading="lazy" decoding="async" class="max-h-[600px] w-full object-cover">
  </a>
<% } %>
