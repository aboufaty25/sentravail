<%
  const m = post.meta || {};
  const mine = m.myReaction ? REACTIONS[m.myReaction] : null;
%>
<div id="social-<%= post.id %>" <%= locals.oob ? 'hx-swap-oob=true' : '' %>>
  <% if (post.likesCount || post.commentsCount || post.sharesCount) { %>
  <div class="flex items-center justify-between px-3 sm:px-4 py-2 text-[15px] text-gray-500">
    <span class="flex items-center gap-1">
      <% if (post.likesCount) { %><span class="text-base leading-none"><%= reactionSummary(m.topReactions) %></span> <span><%= formatCount(post.likesCount) %></span><% } %>
    </span>
    <span class="flex gap-3">
      <% if (post.commentsCount) { %><button type="button" class="hover:underline" @click="$dispatch('open-comments-<%= post.id %>')"><%= formatCount(post.commentsCount) %> commentaire<%= post.commentsCount > 1 ? 's' : '' %></button><% } %>
      <% if (post.sharesCount) { %><span><%= formatCount(post.sharesCount) %> partage<%= post.sharesCount > 1 ? 's' : '' %></span><% } %>
    </span>
  </div>
  <% } %>
  <div class="mx-3 sm:mx-4 flex border-t border-gray-200 py-1 text-[14px] sm:text-[15px] font-semibold text-gray-600">
    <% if (currentUser) { %>
      <div class="relative flex-1" x-data="reactionButton(<%= post.id %>, '<%= m.myReaction || '' %>')" @click.outside="open = false">
        <div x-cloak x-show="open" x-transition.scale.origin.bottom.left class="absolute bottom-full left-0 z-20 mb-1 flex gap-1 rounded-full bg-white px-2 py-1.5 shadow-lg ring-1 ring-black/5" role="menu" aria-label="Choisir une réaction">
          <% Object.entries(REACTIONS).forEach(([key, r]) => { %>
            <button type="button" @click="send('<%= key %>')" class="flex h-10 w-10 items-center justify-center rounded-full text-[26px] transition-transform hover:scale-125 active:scale-110" title="<%= r.label %>" aria-label="<%= r.label %>" role="menuitem"><%= r.emoji %></button>
          <% }) %>
        </div>
        <button type="button" class="flex w-full items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100 select-none <%= mine ? mine.color : '' %>"
          @pointerdown="pressStart($event)" @pointerup="pressEnd()" @pointerleave="pressCancel()" @contextmenu.prevent
          @mouseenter="hoverOpen()" @mouseleave="hoverClose()" @click="tap()" @keydown.enter.prevent="tap()"
          aria-pressed="<%= mine ? 'true' : 'false' %>" style="-webkit-touch-callout:none">
          <% if (mine) { %><span class="text-lg leading-none"><%= mine.emoji %></span> <span><%= mine.label %></span>
          <% } else { %><%- icon('thumb', 'w-5 h-5') %> <span>J'aime</span><% } %>
        </button>
      </div>
    <% } else { %>
      <button type="button" data-login="Connectez-vous pour aimer cette publication." class="flex flex-1 items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100"><%- icon('thumb', 'w-5 h-5') %> J'aime</button>
    <% } %>
    <button type="button" class="flex flex-1 items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100" @click="$dispatch('open-comments-<%= post.id %>')">
      <%- icon('chat', 'w-5 h-5') %> <span class="hidden min-[360px]:inline">Commenter</span>
    </button>
    <% if (post.visibility === 'network' && !post.sharedPostId) { %>
    <span class="flex flex-1 items-center justify-center gap-1.5 py-2 text-gray-300" title="Réservée au réseau de l'auteur"><%- icon('share', 'w-5 h-5') %> <span class="hidden min-[360px]:inline">Partager</span></span>
    <% } else { %>
    <button type="button" class="flex flex-1 items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100"
      @click="$dispatch('open-share', { id: <%= post.sharedPost ? post.sharedPost.id : post.id %>, url: '<%= appUrl %>/publications/<%= post.sharedPost ? post.sharedPost.id : post.id %>', loggedIn: <%= !!currentUser %> })">
      <%- icon('share', 'w-5 h-5') %> <span class="hidden min-[360px]:inline">Partager</span>
    </button>
    <% } %>
    <% if (currentUser) { %>
      <button type="button" class="flex flex-1 items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100 <%= m.saved ? 'text-brand-600' : '' %>"
        hx-post="/publications/<%= post.id %>/enregistrer" hx-target="#social-<%= post.id %>" hx-swap="outerHTML" aria-pressed="<%= m.saved ? 'true' : 'false' %>" title="<%= m.saved ? 'Retirer des enregistrements' : 'Enregistrer' %>">
        <%- icon('bookmark', `w-5 h-5 ${m.saved ? 'fill-current' : ''}`) %> <span class="hidden sm:inline"><%= m.saved ? 'Enregistré' : 'Enregistrer' %></span>
      </button>
    <% } else { %>
      <button type="button" data-login="Connectez-vous pour enregistrer cette publication et la retrouver plus tard." class="flex flex-1 items-center justify-center gap-1.5 rounded-md py-2 hover:bg-gray-100" title="Enregistrer">
        <%- icon('bookmark', 'w-5 h-5') %> <span class="hidden sm:inline">Enregistrer</span>
      </button>
    <% } %>
  </div>
</div>
