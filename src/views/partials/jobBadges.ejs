<% if (post.isFeatured && post.featuredUntil && new Date(post.featuredUntil) > new Date()) { %>
  <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-amber-800"><%- icon('star', 'w-3 h-3') %> À la une</span>
<% } %>
<% if (job.isOfficial) { %>
  <span class="inline-flex items-center gap-1 rounded-full bg-senegal-green/10 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-senegal-green"><%- icon('check', 'w-3 h-3') %> Officielle</span>
<% } %>
<% if (job.isExpired) { %>
  <span class="rounded-full bg-gray-200 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-gray-600">Expirée</span>
<% } %>
