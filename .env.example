# --- Application ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-with-a-long-random-string

# --- MySQL / MariaDB (Hostinger: hPanel > Bases de données MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentravail
DB_USER=sentravail
DB_PASSWORD=sentravail
# Used by `npm test` only (wiped on each run)
DB_NAME_TEST=sentravail_test

# --- Email (SMTP). Leave SMTP_HOST empty in dev: emails are printed in the console ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SenTravail <no-reply@sentravail.com>"

# --- Seed ---
SEED_PASSWORD=Sentravail2026!
