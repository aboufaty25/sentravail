# --- Application ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-with-a-long-random-string

# --- MySQL / MariaDB (Hostinger: hPanel > Bases de données MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentravail
DB_USER=sentravail
DB_PASSWORD=sentravail
# Used by `npm test` only (wiped on each run)
DB_NAME_TEST=sentravail_test

# --- Email (SMTP). Leave SMTP_HOST empty in dev: emails are printed in the console ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SenTravail <no-reply@sentravail.com>"

# --- Media (Cloudinary: https://console.cloudinary.com > Settings > API Keys) ---
# Strongly recommended in production. If empty, images are stored on local disk
# in UPLOAD_DIR (default: public/uploads), which may be wiped on redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=

# --- Feed ---
FEED_PAGE_SIZE=10
# Score above which a post leaves its author's network and reaches everyone (Phase 6)
VIRAL_THRESHOLD=5

# --- Seed ---
SEED_PASSWORD=Sentravail2026!
