# --- Application ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-with-a-long-random-string

# --- MySQL / MariaDB (Hostinger: hPanel > Bases de données MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentravail
DB_USER=sentravail
DB_PASSWORD=sentravail
# Used by `npm test` only (wiped on each run)
DB_NAME_TEST=sentravail_test

# --- Email (SMTP). Leave SMTP_HOST empty in dev: emails are printed in the console ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SenTravail <no-reply@sentravail.com>"

# --- Media (Cloudinary: https://console.cloudinary.com > Settings > API Keys) ---
# Optional. If empty, images are stored on the server's disk in UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for uploaded files when Cloudinary is not used. Keep it OUTSIDE the app folder.
# Empty = automatic: ~/sentravail-uploads in production, public/uploads in development.
UPLOAD_DIR=

# Private folder for CVs (never publicly served). Empty = automatic:
# ~/sentravail-private/cvs in production, storage/cvs in development.
CV_DIR=
# Validity of the CV download links put in application emails
CV_LINK_DAYS=90

# --- Feed ---
FEED_PAGE_SIZE=10
# Score above which a post leaves its author's network and reaches everyone (Phase 6)
VIRAL_THRESHOLD=5
# How long an approved/official job stays "À la une"
FEATURED_DAYS=7
# Number of reports after which a post or comment is hidden until an admin reviews it
REPORT_AUTOHIDE=3

# --- Google AdSense (empty = no ads and no cookie banner) ---
# Publisher ID from AdSense > Account > Account information, e.g. ca-pub-1234567890123456
# Fallback only: Google Analytics / Search Console are normally set in the admin (/admin/google).
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Google Indexing API (offers sent to Google for Jobs as soon as they change) ---
# Service account JSON key, stored OUTSIDE public_html (never commit it), e.g.
# /home/u123456789/sentravail-private/indexing.json
GOOGLE_INDEXING_KEY_FILE=
# ...or, instead of the file, its client_email and private_key (newlines as \n):
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=

# Fallback only: AdSense is normally configured in the admin (/admin/publicites).
ADSENSE_CLIENT_ID=
# Ad unit IDs (AdSense > Ads > By ad unit > Display ads): one per placement
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_JOB=

# --- Sign in with Google / Apple (optional; buttons appear when filled) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorized redirect URI: https://sentravail.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer > Identifiers > Services ID (Sign in with Apple), return URL:
#   https://sentravail.com/auth/apple/callback ; Keys > a key with Sign in with Apple (.p8)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Content of the .p8 file on one line, newlines written as \n
APPLE_PRIVATE_KEY=

# --- Administrators ---
# Comma-separated emails of EXISTING accounts promoted to admin at each startup.
# Sign up on the site first, then set this and restart the app.
ADMIN_EMAILS=

# --- Seed ---
SEED_PASSWORD=Sentravail2026!
